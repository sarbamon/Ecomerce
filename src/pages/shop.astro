---
import Layout from "./_Layout.astro";
import Filters from "./Shop/Filters/_Filters.astro";
import ProductGrid from "./Shop/Product Grid/_ProductGrid.astro";

// Get active category from URL search params
const url = new URL(Astro.request.url);
const activeCategory = url.searchParams.get("category") || "All";
---

<Layout title={`JerseySports | Shop ${activeCategory}`}>
  <!-- Category Navigation Bar -->
  <Filters />

  <!-- Shop Header Info -->
  <div class="px-4 py-6 bg-white border-b border-black/10 select-none">
    <div class="max-w-md mx-auto">
      <span class="text-[9px] font-mono text-black/40 uppercase tracking-widest font-bold">Catalog</span>
      <h2 class="text-3xl font-black uppercase tracking-tight leading-none mt-1">
        {activeCategory === "All" ? "ALL JERSEYS" : `${activeCategory} Collection`}
      </h2>
    </div>
  </div>

  <!-- Product List Grid -->
  <div class="max-w-md mx-auto">
    <ProductGrid activeCategory={activeCategory} />
  </div>
</Layout>
