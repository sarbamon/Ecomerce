---
// Minimalist Monochrome Header component
---
<header class="sticky top-0 z-40 bg-white border-b border-black select-none">
  <div class="max-w-md mx-auto px-4 py-3 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="text-2xl font-black tracking-tighter hover:opacity-75 transition-opacity">
      JERSEY<span class="text-white bg-black px-1.5 py-0.5 ml-1 text-lg rounded-sm">SPORTS</span>
    </a>

    <!-- Navigation Action Buttons -->
    <div class="flex items-center gap-4">
      <!-- Search Button -->
      <button 
        id="search-toggle-btn"
        class="p-1.5 rounded-full hover:bg-black/5 transition-colors focus:outline-none"
        aria-label="Search items"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.602 10.602Z" />
        </svg>
      </button>

      <!-- Account/Profile Button -->
      <a 
        href="/account"
        class="p-1.5 rounded-full hover:bg-black/5 transition-colors block"
        aria-label="View account page"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
        </svg>
      </a>

      <!-- Cart Button -->
      <a 
        href="/cart"
        class="relative p-1.5 rounded-full hover:bg-black/5 transition-colors block"
        aria-label="View shopping cart"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
        </svg>
        <span 
          id="header-cart-badge" 
          class="absolute -top-0.5 -right-0.5 w-5 h-5 bg-black text-white text-[10px] font-bold rounded-full flex items-center justify-center scale-0 transition-transform duration-200"
        >
          0
        </span>
      </a>
    </div>
  </div>
</header>

<script>
  // Simple helper to update the cart badge count in real-time
  function updateCartBadge() {
    const badge = document.getElementById("header-cart-badge");
    if (!badge) return;

    try {
      const cart = JSON.parse(localStorage.getItem("mono_cart") || "[]");
      const totalItems = cart.reduce((sum: number, item: any) => sum + item.quantity, 0);

      if (totalItems > 0) {
        badge.textContent = totalItems.toString();
        badge.classList.remove("scale-0");
        badge.classList.add("scale-100");
      } else {
        badge.classList.remove("scale-100");
        badge.classList.add("scale-0");
      }
    } catch (e) {
      console.error("Cart badge update error", e);
    }
  }

  // Run on mount
  updateCartBadge();

  // Listen to localstorage updates / cart events
  window.addEventListener("storage", updateCartBadge);
  window.addEventListener("cartUpdated", updateCartBadge);
</script>
