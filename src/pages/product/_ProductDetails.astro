---
const { product } = Astro.props;

const productImage = product?.images?.[0] || "";
const availableSizes = product?.sizes || [];
const availableColors = product?.colors || [];

const firstAvailableSize = availableSizes.find(
  (size) => size.stock > 0
);

const hasStock = availableSizes.some(
  (size) => size.stock > 0
);

const totalStock = availableSizes.reduce((acc, s) => acc + (s.stock || 0), 0);
---

<div class="px-6 py-8 flex flex-col gap-6 select-none bg-white">

  <!-- Header Info -->
  <div>
    <div class="flex items-center gap-2 mb-1.5">

      <span
        class="text-[9px] font-mono font-bold border border-black px-1.5 py-0.5 uppercase tracking-widest"
      >
        {product.category}
      </span>

      {
        product.badge && (
          <span
            class="text-[9px] font-mono font-bold bg-black text-white px-1.5 py-0.5 uppercase tracking-widest"
          >
            {product.badge}
          </span>
        )
      }

    </div>

    <h1 class="text-3xl font-black tracking-tight uppercase leading-none">
      {product.name}
    </h1>

    <div class="flex items-baseline gap-3 mt-2">

      <span class="font-mono text-xl font-bold">
        ₹{product.price}
      </span>

      {
        product.compareAtPrice &&
        product.compareAtPrice > product.price && (
          <>
            <span class="font-mono text-sm text-black/40 line-through">
              ₹{product.compareAtPrice}
            </span>

            <span
              class="font-mono text-[9px] font-bold text-red-600 border border-red-600 px-1 py-0.5 rounded-sm uppercase tracking-wide"
            >
              {Math.round(
                ((product.compareAtPrice - product.price) /
                  product.compareAtPrice) *
                  100
              )}
              % OFF
            </span>
          </>
        )
      }

    </div>

    <!-- Stock Status Pill -->
    <div class="mt-4 flex">
      {totalStock === 0 ? (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-mono font-black uppercase tracking-wider bg-red-55/10 text-red-600 border border-red-600/20">
          <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span>
          OUT OF STOCK
        </span>
      ) : totalStock <= 5 ? (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-mono font-black uppercase tracking-wider bg-amber-55/10 text-amber-700 border border-amber-600/25 animate-pulse">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>
          LOW STOCK (ONLY {totalStock} LEFT!)
        </span>
      ) : (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-mono font-black uppercase tracking-wider bg-green-55/10 text-green-700 border border-green-600/20">
          <span class="w-1.5 h-1.5 rounded-full bg-green-600 animate-ping absolute inline-flex h-1.5 w-1.5 rounded-full bg-green-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-green-600"></span>
          IN STOCK ({totalStock} AVAILABLE)
        </span>
      )}
    </div>
  </div>


  <!-- Description -->
  <p
    class="text-xs text-black/60 leading-relaxed uppercase font-sans border-t border-black/10 pt-4"
  >
    {product.description}
  </p>


  <!-- Specifications -->
  <div class="border-t border-black/10 pt-4">

    <h4
      class="font-mono text-[10px] font-bold tracking-widest text-black/40 uppercase mb-2"
    >
      Specifications
    </h4>

    {
      product.features?.length ? (
        <ul
          class="list-disc list-inside font-mono text-[10px] text-black/70 space-y-1 uppercase"
        >
          {product.features.map((feature: string) => (
            <li>{feature}</li>
          ))}
        </ul>
      ) : (
        <p class="font-mono text-[10px] text-black/40 uppercase">
          No specifications available
        </p>
      )
    }

  </div>


  <!-- Color Selector -->
  {
    availableColors.length > 0 && (
      <div class="border-t border-black/10 pt-4">

        <div class="flex justify-between items-center mb-3">

          <h4
            class="font-mono text-[10px] font-bold tracking-widest text-black/40 uppercase"
          >
            Select Color
          </h4>

          <span
            id="selected-color-display"
            class="font-mono text-xs font-bold uppercase"
          >
            {availableColors[0].name}
          </span>

        </div>

        <div class="flex gap-3">

          {availableColors.map((color: any, idx: number) => (
            <button
              type="button"
              class={`color-btn w-8 h-8 rounded-full border border-black/20 focus:outline-none transition-transform duration-200 relative ${
                idx === 0
                  ? "scale-110 ring-2 ring-black"
                  : "hover:scale-105"
              }`}
              style={`background-color: ${color.hex};`}
              data-color-hex={color.hex}
              data-color-name={color.name}
              title={color.name}
              aria-label={`Select ${color.name}`}
            >
              {
                idx === 0 && (
                  <span class="absolute inset-1.5 rounded-full border border-white mix-blend-difference" />
                )
              }
            </button>
          ))}

        </div>
      </div>
    )
  }


  <!-- Size Selector -->
  <div class="border-t border-black/10 pt-4">

    <div class="flex justify-between items-center mb-3">

      <h4
        class="font-mono text-[10px] font-bold tracking-widest text-black/40 uppercase"
      >
        Select Size
      </h4>

      <span
        id="selected-size-display"
        class="font-mono text-xs font-bold uppercase"
      >
        {firstAvailableSize?.name || "OUT OF STOCK"}
      </span>

    </div>

    <div class="flex gap-2">

      {["S", "M", "L", "XL", "XXL"].map((sizeName) => {

        const sizeObj = availableSizes.find(
          (size) => size.name === sizeName
        );

        const stock = sizeObj?.stock || 0;
        const isOutOfStock = stock <= 0;

        const isActive =
          firstAvailableSize?.name === sizeName;

        return (
          <button
            type="button"
            disabled={isOutOfStock}
            class={`size-btn flex-grow py-3 border text-xs font-mono font-bold uppercase transition-colors ${
              isOutOfStock
                ? "border-black/10 text-black/20 bg-zinc-50 cursor-not-allowed line-through"
                : isActive
                  ? "border-black bg-black text-white"
                  : "border-black bg-white text-black hover:bg-zinc-50"
            }`}
            data-size={sizeName}
            data-stock={stock}
          >
            {sizeName}
          </button>
        );
      })}

    </div>

  </div>


  <!-- Purchase Actions -->
  <div
    class="border-t border-black/10 pt-6 flex flex-col gap-2"
  >

    <div class="grid grid-cols-2 gap-2">

      <!-- Add To Cart -->
      <button
        id="add-to-cart-btn"
        type="button"
        disabled={!hasStock}
        class={`font-black py-4 uppercase text-[10px] tracking-wider transition-all duration-200 ${
          !hasStock
            ? "bg-zinc-300 text-black/40 cursor-not-allowed w-full"
            : "bg-white text-black border border-black hover:bg-zinc-50 active:scale-[0.98] w-full"
        }`}
      >
        {hasStock ? "ADD TO CART" : "OUT OF STOCK"}
      </button>


      <!-- Buy Now -->
      <button
        id="buy-now-btn"
        type="button"
        disabled={!hasStock}
        class={`font-black py-4 uppercase text-[10px] tracking-wider transition-all duration-200 ${
          !hasStock
            ? "bg-zinc-300 text-black/40 cursor-not-allowed w-full"
            : "bg-black text-white hover:bg-zinc-950 active:scale-[0.98] w-full"
        }`}
      >
        {hasStock ? "BUY NOW" : "OUT OF STOCK"}
      </button>

    </div>


    <a
      href="/shop"
      class="text-center font-mono text-[10px] text-black/50 hover:text-black py-2 tracking-widest uppercase transition-colors"
    >
      ← CONTINUE SHOPPING
    </a>

  </div>

</div>


<script define:vars={{ product }}>

  /*
   * PRODUCT STATE
   */

  const firstAvailableSizeObj =
    product.sizes?.find(
      (size) => size.stock > 0
    ) || null;

  let selectedSize =
    firstAvailableSizeObj?.name || "";

  let selectedColor =
    product.colors?.[0]?.hex || "";


  /*
   * ELEMENTS
   */

  const sizeButtons =
    document.querySelectorAll(".size-btn");

  const colorButtons =
    document.querySelectorAll(".color-btn");

  const sizeDisplay =
    document.getElementById(
      "selected-size-display"
    );

  const colorDisplay =
    document.getElementById(
      "selected-color-display"
    );

  const nameInput =
    document.getElementById("custom-name");

  const numberInput =
    document.getElementById("custom-number");

  const addToCartBtn =
    document.getElementById(
      "add-to-cart-btn"
    );

  const buyNowBtn =
    document.getElementById(
      "buy-now-btn"
    );


  /*
   * COLOR SELECTION
   */

  colorButtons.forEach((btn) => {

    btn.addEventListener("click", () => {

      colorButtons.forEach((button) => {

        button.classList.remove(
          "scale-110",
          "ring-2",
          "ring-black"
        );

        button.classList.add(
          "hover:scale-105"
        );

      });


      btn.classList.remove(
        "hover:scale-105"
      );

      btn.classList.add(
        "scale-110",
        "ring-2",
        "ring-black"
      );


      selectedColor =
        btn.getAttribute(
          "data-color-hex"
        ) || "";


      const selectedColorName =
        btn.getAttribute(
          "data-color-name"
        ) || "";


      if (colorDisplay) {
        colorDisplay.textContent =
          selectedColorName;
      }


      emitPreviewUpdate();

    });

  });


  /*
   * SIZE SELECTION
   */

  sizeButtons.forEach((btn) => {

    btn.addEventListener("click", () => {

      if (btn.hasAttribute("disabled")) {
        return;
      }


      sizeButtons.forEach((button) => {

        if (
          !button.hasAttribute("disabled")
        ) {
          button.classList.remove(
            "bg-black",
            "text-white"
          );

          button.classList.add(
            "bg-white",
            "text-black"
          );
        }

      });


      btn.classList.remove(
        "bg-white",
        "text-black"
      );

      btn.classList.add(
        "bg-black",
        "text-white"
      );


      selectedSize =
        btn.getAttribute(
          "data-size"
        ) || "";


      const stockVal = parseInt(btn.getAttribute("data-stock") || "0", 10);
      if (sizeDisplay) {
        sizeDisplay.textContent =
          selectedSize + (stockVal <= 5 ? ` (ONLY ${stockVal} LEFT!)` : ` (${stockVal} AVAILABLE)`);
      }

    });

  });


  /*
   * CUSTOM JERSEY PREVIEW
   */

  function emitPreviewUpdate() {

    const customName =
      nameInput
        ? nameInput.value.trim()
        : "";

    const customNumber =
      numberInput
        ? numberInput.value.trim()
        : "";


    if (
      numberInput &&
      customNumber
    ) {

      numberInput.value =
        customNumber.replace(
          /\D/g,
          ""
        );

    }


    const event =
      new CustomEvent(
        "updateJerseyPreview",
        {
          detail: {
            name:
              nameInput
                ? nameInput.value
                : "",

            number:
              numberInput
                ? numberInput.value
                : "",

            color:
              selectedColor
          }
        }
      );


    window.dispatchEvent(event);

  }


  nameInput?.addEventListener(
    "input",
    emitPreviewUpdate
  );

  numberInput?.addEventListener(
    "input",
    emitPreviewUpdate
  );


  /*
   * CREATE CART ITEM
   */

  function createCartItem() {

    const name =
      nameInput
        ? nameInput.value.trim().toUpperCase()
        : "";

    const number =
      numberInput
        ? numberInput.value.trim()
        : "";


    const colorClean =
      selectedColor
        ? selectedColor.replace("#", "")
        : "";


    const prodId =
      product._id ||
      product.slug ||
      product.id;


    /*
     * IMPORTANT:
     * This is now the REAL uploaded
     * product image URL.
     *
     * Previously this was called "pattern",
     * which belonged to the old demo system.
     */

    const image =
      product.images?.[0] || "";


    return {

      cartId:
        `${prodId}-${selectedSize}-${colorClean}-${name}-${number}`,

      id:
        prodId,

      name:
        product.name,

      price:
        product.price,

      image:
        image,

      size:
        selectedSize,

      color:
        selectedColor,

      customName:
        name || "MONO",

      customNumber:
        number || "10",

      isCustomized:
        name !== "" ||
        number !== "" ||
        product.category === "CUSTOM",

      quantity:
        1

    };

  }


  /*
   * ADD TO CART
   */

  addToCartBtn?.addEventListener(
    "click",
    () => {

      if (!selectedSize) {
        alert("PLEASE SELECT A SIZE");
        return;
      }


      const selectedSizeObj =
        product.sizes?.find(
          (size) =>
            size.name === selectedSize
        );


      if (
        !selectedSizeObj ||
        selectedSizeObj.stock <= 0
      ) {

        alert(
          "SELECTED SIZE IS OUT OF STOCK"
        );

        return;

      }


      const cartItem =
        createCartItem();


      try {

        const cart =
          JSON.parse(
            localStorage.getItem(
              "mono_cart"
            ) || "[]"
          );


        const existingIndex =
          cart.findIndex(
            (item) =>
              item.cartId ===
              cartItem.cartId
          );


        if (existingIndex > -1) {

          cart[
            existingIndex
          ].quantity += 1;

        } else {

          cart.push(
            cartItem
          );

        }


        localStorage.setItem(
          "mono_cart",
          JSON.stringify(cart)
        );


        /*
         * Notify header/cart
         */

        window.dispatchEvent(
          new Event("cartUpdated")
        );


        /*
         * Button feedback
         */

        const originalText =
          addToCartBtn.textContent;


        addToCartBtn.textContent =
          "ADDED TO CART ✓";


        addToCartBtn.classList.remove(
          "bg-black",
          "text-white"
        );


        addToCartBtn.classList.add(
          "bg-white",
          "text-black",
          "border",
          "border-black"
        );


        addToCartBtn.disabled =
          true;


        setTimeout(() => {

          addToCartBtn.textContent =
            originalText;


          addToCartBtn.classList.remove(
            "bg-white",
            "text-black",
            "border",
            "border-black"
          );


          addToCartBtn.classList.add(
            "bg-black",
            "text-white"
          );


          addToCartBtn.disabled =
            false;

        }, 1500);

      } catch (error) {

        console.error(
          "Failed to add item to cart:",
          error
        );

      }

    }
  );


  /*
   * BUY NOW
   */

  buyNowBtn?.addEventListener(
    "click",
    () => {

      if (!selectedSize) {

        alert(
          "PLEASE SELECT A SIZE"
        );

        return;

      }


      const selectedSizeObj =
        product.sizes?.find(
          (size) =>
            size.name ===
            selectedSize
        );


      if (
        !selectedSizeObj ||
        selectedSizeObj.stock <= 0
      ) {

        alert(
          "SELECTED SIZE IS OUT OF STOCK"
        );

        return;

      }


      const cartItem =
        createCartItem();


      try {

        const cart =
          JSON.parse(
            localStorage.getItem(
              "mono_cart"
            ) || "[]"
          );


        const existingIndex =
          cart.findIndex(
            (item) =>
              item.cartId ===
              cartItem.cartId
          );


        if (existingIndex > -1) {

          cart[
            existingIndex
          ].quantity += 1;

        } else {

          cart.push(
            cartItem
          );

        }


        localStorage.setItem(
          "mono_cart",
          JSON.stringify(cart)
        );


        window.dispatchEvent(
          new Event("cartUpdated")
        );


        /*
         * Go directly to checkout
         */

        window.location.href =
          "/checkout";

      } catch (error) {

        console.error(
          "Failed to proceed with Buy Now:",
          error
        );

      }

    }
  );

</script>