---
const { pattern, name = "", number = "", view = "front", color } = Astro.props;

// Determine default fill color based on pattern
const baseColor = color || (pattern === "solid-white" ? "#ffffff" : pattern === "pink-cannon" ? "#fbcfe8" : "#000000");

// Simple contrast check for light colors in our preset list
const isLight = baseColor.toLowerCase() === "#ffffff" || 
                baseColor.toLowerCase() === "#fafafa" || 
                baseColor.toLowerCase() === "#facc15" || 
                baseColor.toLowerCase() === "#fda4af" ||
                baseColor.toLowerCase() === "#fbcfe8";

const contrastColor = isLight ? "#000000" : "#ffffff";
const patId = `pat-${pattern}-${baseColor.replace('#', '')}`;
---

<svg viewBox="0 0 400 450" class="w-full h-full drop-shadow-[0_10px_20px_rgba(0,0,0,0.15)]" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Pattern definitions dynamically colored -->
    {pattern === "vertical-stripes" && (
      <pattern id={patId} width="40" height="40" patternUnits="userSpaceOnUse">
        <rect width="20" height="40" fill={baseColor} />
        <rect x="20" width="20" height="40" fill="#ffffff" />
      </pattern>
    )}
    
    {pattern === "horizontal-stripes" && (
      <pattern id={patId} width="40" height="40" patternUnits="userSpaceOnUse">
        <rect width="40" height="20" fill={baseColor} />
        <rect y="20" width="40" height="20" fill="#ffffff" />
      </pattern>
    )}
    
    {pattern === "fine-grid" && (
      <pattern id={patId} width="20" height="20" patternUnits="userSpaceOnUse">
        <rect width="20" height="20" fill="#ffffff" />
        <path d="M 20 0 L 0 0 0 20" fill="none" stroke={baseColor} stroke-width="2" />
      </pattern>
    )}
  </defs>

  <!-- Jersey Outline Shadow -->
  <!-- Base Jersey Path -->
  <g class="transition-all duration-300">
    {/* Body */}
    <path
      d="M 120 60 
         L 80 100 
         L 40 130 
         L 70 180 
         L 105 150 
         L 105 390 
         L 295 390 
         L 295 150 
         L 330 180 
         L 360 130 
         L 320 100 
         L 280 60 
         Z"
      fill={
        pattern === "vertical-stripes" || pattern === "horizontal-stripes" || pattern === "fine-grid" 
          ? `url(#${patId})` 
          : baseColor
      }
      stroke="#000000"
      stroke-width="8"
      stroke-linejoin="round"
    />

    {/* Pink Cannon pattern details (shoulder stripes & side panels) */}
    {pattern === "pink-cannon" && (
      <g>
        {/* Left Side Panel */}
        <path d="M 105 180 L 105 390 L 125 390 L 125 180 Z" fill="#000000" />
        {/* Right Side Panel */}
        <path d="M 295 180 L 295 390 L 275 390 L 275 180 Z" fill="#000000" />

        {/* Shoulder Stripes Left sleeve */}
        <line x1="100" y1="80" x2="60" y2="120" stroke="#000000" stroke-width="4" />
        <line x1="90" y1="75" x2="52" y2="113" stroke="#000000" stroke-width="4" />
        <line x1="110" y1="85" x2="68" y2="127" stroke="#000000" stroke-width="4" />

        {/* Shoulder Stripes Right sleeve */}
        <line x1="300" y1="80" x2="340" y2="120" stroke="#000000" stroke-width="4" />
        <line x1="310" y1="75" x2="348" y2="113" stroke="#000000" stroke-width="4" />
        <line x1="290" y1="85" x2="332" y2="127" stroke="#000000" stroke-width="4" />
      </g>
    )}

    {/* Chevron pattern specifically */}
    {pattern === "chevron-black" && (
      <path
        d="M 105 200 L 200 280 L 295 200 L 295 240 L 200 320 L 105 240 Z"
        fill={contrastColor}
      />
    )}

    {/* Chevron Top Neck Detail */}
    {pattern === "chevron-black" && (
      <path
        d="M 150 60 L 200 120 L 250 60 Z"
        fill={contrastColor}
      />
    )}

    {/* Collar / Neckline */}
    <path
      d="M 160 60 C 160 90, 240 90, 240 60"
      fill="none"
      stroke={
        pattern === "solid-white" || pattern === "fine-grid" ? "#000000" : contrastColor
      }
      stroke-width="6"
    />

    {/* Sleek trims on sleeves */}
    <path
      d="M 40 130 L 70 180"
      stroke={
        pattern === "solid-white" || pattern === "fine-grid" ? "#000000" : contrastColor
      }
      stroke-width="8"
    />
    <path
      d="M 360 130 L 330 180"
      stroke={
        pattern === "solid-white" || pattern === "fine-grid" ? "#000000" : contrastColor
      }
      stroke-width="8"
    />

    {/* FRONT details (e.g. Brand mark and crest) */}
    {view === "front" && (
      <g>
        {/* Brand logo */}
        <line 
          x1="145" y1="120" x2="165" y2="120" 
          stroke={pattern === "solid-white" || pattern === "fine-grid" ? "#000000" : contrastColor} 
          stroke-width="4" 
        />
        <line 
          x1="145" y1="128" x2="160" y2="128" 
          stroke={pattern === "solid-white" || pattern === "fine-grid" ? "#000000" : contrastColor} 
          stroke-width="4" 
        />

        {/* Minimalist crest / badge */}
        {pattern === "pink-cannon" ? (
          /* Custom Cannon Silhouette */
          <path
            d="M 233 125 H 255 L 255 129 H 233 Z M 238 129 L 235 134 M 248 129 L 251 134 M 244 121 L 244 125 M 241 123 L 247 123"
            stroke={contrastColor}
            stroke-width="3.5"
            fill="none"
            stroke-linejoin="round"
          />
        ) : (
          <g>
            <circle 
              cx="245" cy="125" r="14" 
              fill="none" 
              stroke={pattern === "solid-white" || pattern === "fine-grid" ? "#000000" : contrastColor} 
              stroke-width="4" 
            />
            <polygon 
              points="245,117 251,128 239,128" 
              fill={pattern === "solid-white" || pattern === "fine-grid" ? "#000000" : contrastColor} 
            />
          </g>
        )}

        {/* Emirates Sponsor Text Logo */}
        {pattern === "pink-cannon" && (
          <g transform="translate(200, 220)" text-anchor="middle">
            <text
              font-family="'Times New Roman', Times, serif"
              font-size="36"
              font-weight="black"
              fill={contrastColor}
              letter-spacing="0.5"
            >
              Emirates
            </text>
            <text
              y="28"
              font-family="'Outfit', sans-serif"
              font-size="12"
              font-weight="900"
              fill={contrastColor}
              letter-spacing="6"
            >
              FLY BETTER
            </text>
          </g>
        )}
        
        {/* Big chest/front number if exists */}
        {number && pattern !== "pink-cannon" && (
          <text
            x="200"
            y="250"
            font-family="Impact, sans-serif"
            font-size="90"
            font-weight="bold"
            text-anchor="middle"
            fill={
              pattern === "solid-white" || pattern === "fine-grid" ? "#000000" : contrastColor
            }
            stroke={
              pattern === "solid-white" || pattern === "fine-grid" ? "#ffffff" : contrastColor
            }
            stroke-width={pattern === "solid-white" || isLight ? "0" : "2"}
          >
            {number}
          </text>
        )}
      </g>
    )}

    {/* BACK details (e.g. name and number customization) */}
    {view === "back" && (
      <g>
        {/* Player Name */}
        <text
          x="200"
          y="150"
          font-family="'Courier New', Courier, monospace"
          font-size="28"
          font-weight="900"
          letter-spacing="4"
          text-anchor="middle"
          fill={
            pattern === "solid-white" || pattern === "fine-grid" ? "#000000" : contrastColor
          }
        >
          {name.toUpperCase() || "MONO"}
        </text>

        {/* Player Number */}
        <text
          x="200"
          y="270"
          font-family="Impact, Arial Black, sans-serif"
          font-size="110"
          font-weight="bold"
          text-anchor="middle"
          fill={
            pattern === "solid-white" || pattern === "fine-grid" ? "#000000" : contrastColor
          }
          stroke={
            pattern === "solid-white" || pattern === "fine-grid" ? "#ffffff" : "#000000"
          }
          stroke-width="4"
        >
          {number || "10"}
        </text>
      </g>
    )}
  </g>
</svg>
