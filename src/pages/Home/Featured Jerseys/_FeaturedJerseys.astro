---
import { products } from "../../../data/products";
import JerseySvg from "../../product/_JerseySvg.astro";

// Get first 3 products as featured
const featured = products.slice(0, 3);
---
<section class="bg-black text-white py-16 px-4 border-b border-white/20 overflow-hidden">
  <div class="max-w-md mx-auto">
    <div class="flex items-end justify-between mb-8">
      <div>
        <span class="text-xs font-mono text-white/50 uppercase tracking-widest font-bold">New Drops</span>
        <h2 class="text-3xl font-black uppercase tracking-tight">FEATURED</h2>
      </div>
      <a href="/shop" class="text-xs font-mono tracking-widest hover:text-white/60 transition-colors uppercase border-b border-white pb-0.5">
        VIEW ALL
      </a>
    </div>

    <!-- Horizontal Swipeable List (Perfect for mobile) -->
    <div class="flex gap-4 overflow-x-auto pb-6 snap-x snap-mandatory scrollbar-none">
      {featured.map((jersey) => (
        <a 
          href={`/product/${jersey.id}`}
          class="min-w-[85%] bg-zinc-950 border border-white/10 rounded-sm p-4 snap-center flex flex-col justify-between group active:border-white transition-all duration-300"
        >
          {/* Badge */}
          <div class="flex justify-between items-start">
            <span class="text-[9px] font-mono font-bold tracking-widest bg-white text-black px-1.5 py-0.5 rounded-sm uppercase">
              {jersey.badge}
            </span>
            <span class="font-mono text-sm font-semibold">₹{jersey.price}</span>
          </div>

          {/* Jersey SVG Preview */}
          <div class="w-full max-w-[180px] mx-auto my-6 group-hover:scale-105 transition-transform duration-300">
            <JerseySvg pattern={jersey.pattern} view="front" />
          </div>

          {/* Info */}
          <div class="mt-2">
            <h3 class="font-bold text-base tracking-tight uppercase group-hover:underline">{jersey.name}</h3>
            <p class="text-xs font-mono text-white/40 uppercase mt-0.5">{jersey.category}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .scrollbar-none {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>
