---
import { apiFetch } from "../../../lib/api.js";
import JerseySvg from "../../product/_JerseySvg.astro";

const { title = "FEATURED", subtitle = "New Drops" } = Astro.props;

let featured = [];
try {
  const data = await apiFetch("/products/featured");
  featured = data.products || [];
} catch (error) {
  console.error("Failed to load featured products:", error);
}
---
<section class="bg-black text-white py-16 px-4 border-b border-white/20 overflow-hidden">
  <div class="max-w-md mx-auto">
    <div class="flex items-end justify-between mb-8">
      <div>
        <span class="text-[10px] font-mono text-white/50 uppercase tracking-widest font-bold">{subtitle}</span>
        <h2 class="text-2xl font-black uppercase tracking-tight mt-0.5">{title}</h2>
      </div>
      <a href="/shop" class="text-xs font-mono tracking-widest hover:text-white/60 transition-colors uppercase border-b border-white pb-0.5">
        VIEW ALL
      </a>
    </div>

    <!-- Horizontal Swipeable List (Perfect for mobile) -->
    <div class="flex gap-4 overflow-x-auto pb-6 snap-x snap-mandatory scrollbar-none">
      {featured.map((jersey) => (
        <a 
          href={`/product/${jersey.slug}`}
          class="min-w-[85%] bg-zinc-950 border border-white/10 rounded-sm p-4 snap-center flex flex-col justify-between group active:border-white transition-all duration-300"
        >
          {/* Badge */}
          <div class="flex justify-between items-start">
            <span class="text-[9px] font-mono font-bold tracking-widest bg-white text-black px-1.5 py-0.5 rounded-sm uppercase">
              {jersey.badge}
            </span>
            <div class="flex items-center gap-2 font-mono text-sm font-semibold">
              <span>₹{jersey.price}</span>
              {jersey.compareAtPrice && jersey.compareAtPrice > jersey.price && (
                <span class="text-xs text-white/40 line-through">₹{jersey.compareAtPrice}</span>
              )}
            </div>
          </div>

          {/* Jersey SVG Preview / Picture URL */}
          <div class="w-full max-w-[180px] mx-auto my-6 group-hover:scale-105 transition-transform duration-300">
            {jersey.images && jersey.images[0] && !["vertical-stripes", "horizontal-stripes", "solid-black", "chevron-black", "solid-white", "fine-grid"].includes(jersey.images[0]) ? (
              <img src={jersey.images[0]} alt={jersey.name} class="w-full h-[180px] object-contain mx-auto" />
            ) : (
              <JerseySvg pattern={jersey.images && jersey.images[0] || "solid-white"} view="front" />
            )}
          </div>

          {/* Info */}
          <div class="mt-2">
            <h3 class="font-bold text-base tracking-tight uppercase group-hover:underline">{jersey.name}</h3>
            <p class="text-xs font-mono text-white/40 uppercase mt-0.5">{jersey.category}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .scrollbar-none {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>
