---
const { data = [] } = Astro.props;

const defaultPromotions = [
  {
    title: "FREE CUSTOM PRINTING",
    description: "NO ADDITIONAL COST",
    badge: "LIMITED OFFER",
    buttonLink: "/shop"
  },
  {
    title: "10% OFF ON 3+ JERSEYS",
    description: "CODE: TEAM10",
    badge: "TEAM ORDERS",
    buttonLink: "/shop"
  },
  {
    title: "PREMIUM ATHLETIC FABRIC",
    description: "BREATHABLE MESH & BONDED SEAMS",
    badge: "GUARANTEED",
    buttonText: "SHOP NOW",
    buttonLink: "/shop"
  }
];

const list = data.length > 0 ? data : defaultPromotions;
---
<section class="bg-white py-8 px-4 border-b border-black select-none">
  <div class="max-w-md mx-auto grid grid-cols-2 gap-3">
    {list.map((promo: any, idx: number) => {
      const isFullWidth = idx === 2; // Keep the third box full-width
      const isWhiteBg = idx % 2 === 1 || idx === 2;
      
      if (isFullWidth) {
        return (
          <a href={promo.buttonLink || "/shop"} class="col-span-2 border border-black p-4 flex items-center justify-between bg-zinc-50 hover:bg-black hover:text-white group transition-all duration-300 relative overflow-hidden">
            <div class="flex items-center gap-3 z-10">
              <div class="w-10 h-10 border border-black flex items-center justify-center font-mono text-[9px] font-black bg-white text-black rounded-full shrink-0">
                {promo.badge ? promo.badge.substring(0, 4) : "100%"}
              </div>
              <div>
                <h3 class="text-xs font-black uppercase tracking-tight leading-tight">{promo.title}</h3>
                <p class="font-mono text-[8px] text-black/50 group-hover:text-white/60 uppercase mt-0.5">{promo.description}</p>
              </div>
            </div>
            <span class="font-mono text-[9px] font-bold text-black border border-black bg-white group-hover:bg-white group-hover:text-black px-2.5 py-1 uppercase shrink-0 transition-colors">
              {promo.buttonText || "EXPLORE"}
            </span>
          </a>
        );
      }
      
      return (
        <a 
          href={promo.buttonLink || "/shop"} 
          class={`border border-black p-4 flex flex-col justify-between aspect-[1.5] relative overflow-hidden group transition-all duration-300 ${
            isWhiteBg 
              ? "bg-white text-black hover:bg-black hover:text-white" 
              : "bg-black text-white hover:bg-white hover:text-black"
          }`}
        >
          <span class={`font-mono text-[8px] tracking-widest uppercase z-10 ${isWhiteBg ? 'text-black/40 group-hover:text-white/40' : 'text-white/45 group-hover:text-black/45'}`}>
            {promo.badge || "LIMITED"}
          </span>
          <div class="z-10">
            <h3 class="text-xs font-black uppercase leading-tight">{promo.title}</h3>
            <p class={`font-mono text-[8px] mt-1 uppercase ${isWhiteBg ? 'text-black/50 group-hover:text-white/40' : 'text-white/40 group-hover:text-black/40'}`}>
              {promo.description}
            </p>
          </div>
        </a>
      );
    })}
  </div>
</section>
