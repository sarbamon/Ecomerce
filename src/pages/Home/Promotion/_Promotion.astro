---
// Promotional graphics/banners section
---
<section class="bg-white py-8 px-4 border-b border-black select-none">
  <div class="max-w-md mx-auto grid grid-cols-2 gap-3">
    <!-- Promo Box 1: Custom Printing -->
    <div class="border border-black p-4 flex flex-col justify-between aspect-[1.5] relative overflow-hidden bg-black text-white group">
      {/* Pattern BG */}
      <div class="absolute inset-0 opacity-10 pointer-events-none bg-[radial-gradient(#fff_1px,transparent_1px)] bg-[size:10px_10px]"></div>
      
      <span class="font-mono text-[9px] tracking-widest uppercase text-white/50 z-10">Limited Offer</span>
      <div class="z-10">
        <h3 class="text-sm font-black uppercase leading-tight">FREE CUSTOM<br />PRINTING</h3>
        <p class="font-mono text-[8px] text-white/40 mt-1 uppercase">NO ADDITIONAL COST</p>
      </div>
    </div>

    <!-- Promo Box 2: Bulk Discount -->
    <div class="border border-black p-4 flex flex-col justify-between aspect-[1.5] relative overflow-hidden bg-white text-black group hover:bg-black hover:text-white transition-all duration-300">
      <span class="font-mono text-[9px] tracking-widest uppercase text-black/40 group-hover:text-white/40 z-10">Team Orders</span>
      <div class="z-10">
        <h3 class="text-sm font-black uppercase leading-tight">10% OFF ON<br />3+ JERSEYS</h3>
        <p class="font-mono text-[8px] text-black/50 group-hover:text-white/40 mt-1 uppercase">CODE: TEAM10</p>
      </div>
    </div>

    <!-- Promo Box 3: Quality Guarantee (Full Width) -->
    <div class="col-span-2 border border-black p-4 flex items-center justify-between bg-zinc-50 relative overflow-hidden">
      <div class="flex items-center gap-3 z-10">
        {/* Graphic badge */}
        <div class="w-10 h-10 border border-black flex items-center justify-center font-mono text-xs font-black bg-white rounded-full">
          100%
        </div>
        <div>
          <h3 class="text-xs font-black uppercase tracking-tight">PREMIUM ATHLETIC FABRIC</h3>
          <p class="font-mono text-[8px] text-black/50 uppercase">BREATHABLE MESH & BONDED SEAMS</p>
        </div>
      </div>
      <span class="font-mono text-[10px] font-bold text-green-700 bg-green-50 border border-green-200 px-2 py-0.5 rounded-sm shrink-0">GUARANTEED</span>
    </div>
  </div>
</section>
