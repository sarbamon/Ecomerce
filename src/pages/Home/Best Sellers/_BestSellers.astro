---
import { products } from "../../../data/products";
import JerseySvg from "../../Product/_JerseySvg.astro";

// Take 3 products for Best Sellers list
const bestSellers = products.slice(1, 4);
---
<section class="bg-white py-16 px-4 border-b border-black">
  <div class="max-w-md mx-auto">
    <div class="flex flex-col mb-8">
      <span class="text-xs font-mono text-black/40 uppercase tracking-widest font-bold">Popular Demand</span>
      <h2 class="text-2xl font-black uppercase tracking-tight">BEST SELLERS</h2>
    </div>

    <!-- Vertical List for best sellers -->
    <div class="flex flex-col gap-4">
      {bestSellers.map((jersey, idx) => (
        <a 
          href={`/product/${jersey.id}`}
          class="flex items-center gap-4 border border-black/10 p-3 hover:border-black transition-all duration-300 group"
        >
          {/* Rank Number */}
          <div class="font-mono text-xl font-black text-black/20 group-hover:text-black transition-colors w-6">
            0{idx + 1}
          </div>

          {/* Mini Jersey Preview */}
          <div class="w-16 h-16 flex-shrink-0 bg-zinc-50 border border-black/5 rounded-sm p-1">
            <JerseySvg pattern={jersey.pattern} view="front" />
          </div>

          {/* Info */}
          <div class="flex-grow min-w-0">
            <div class="flex justify-between items-start">
              <h3 class="font-bold text-sm tracking-tight truncate uppercase group-hover:underline pr-2">
                {jersey.name}
              </h3>
              <span class="font-mono text-xs font-bold shrink-0">₹{jersey.price}</span>
            </div>
            <p class="text-[10px] font-mono text-black/50 uppercase mt-0.5">{jersey.category}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
