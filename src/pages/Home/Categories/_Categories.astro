---
import { categories } from "../../../data/products";

// Displaying sleek category selections
---
<section class="bg-white py-12 px-4 border-b border-black">
  <div class="max-w-md mx-auto">
    <div class="flex flex-col mb-8">
      <span class="text-xs font-mono text-black/40 uppercase tracking-widest font-bold">Categories</span>
      <h2 class="text-2xl font-black uppercase tracking-tight">FIND YOUR SPORT</h2>
    </div>

    <!-- Category Grid -->
    <div class="grid grid-cols-2 gap-3">
      {categories.filter(c => c !== "All").map((category) => (
        <a 
          href={`/shop?category=${category}`}
          class="relative border border-black p-6 group overflow-hidden bg-white text-black hover:bg-black hover:text-white transition-all duration-300 flex flex-col justify-between aspect-square"
        >
          <div class="font-mono text-xs text-black/30 group-hover:text-white/30 transition-colors uppercase">
            Collection
          </div>
          <div>
            <h3 class="text-xl font-bold uppercase tracking-tight">{category}</h3>
            <span class="inline-block mt-2 text-xs font-mono tracking-widest group-hover:translate-x-1 transition-transform duration-300">
              BROWSE →
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
