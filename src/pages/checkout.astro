---
import Layout from "./_Layout.astro";
---

<Layout title="JerseySports | Checkout">
  <div class="px-4 py-8 select-none bg-white min-h-[70vh]">
    <div class="max-w-md mx-auto">
      
      <!-- Checkout Form States -->
      <div id="checkout-form-container">
        <!-- Title -->
        <div class="flex flex-col border-b border-black pb-4 mb-6">
          <span class="text-[9px] font-mono text-black/40 uppercase tracking-widest font-bold">Secure Gateway</span>
          <h2 class="text-3xl font-black uppercase tracking-tight leading-none mt-1">CHECKOUT</h2>
        </div>

        <form id="checkout-form" class="flex flex-col gap-6" onsubmit="event.preventDefault();">
          <!-- Shipping Details -->
          <div class="flex flex-col gap-3">
            <h3 class="font-mono text-xs font-bold uppercase tracking-widest text-black/40 border-b border-black/5 pb-1">
              1. SHIPPING DETAILS
            </h3>
            
            <div>
              <label for="shipping-name" class="block font-mono text-[9px] text-black/60 uppercase mb-1">Full Name</label>
              <input type="text" id="shipping-name" required class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none uppercase" />
            </div>

            <div>
              <label for="shipping-address" class="block font-mono text-[9px] text-black/60 uppercase mb-1">Street Address</label>
              <input type="text" id="shipping-address" required class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none uppercase" />
            </div>

            <div class="grid grid-cols-2 gap-2">
              <div>
                <label for="shipping-city" class="block font-mono text-[9px] text-black/60 uppercase mb-1">City</label>
                <input type="text" id="shipping-city" required class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none uppercase" />
              </div>
              <div>
                <label for="shipping-zip" class="block font-mono text-[9px] text-black/60 uppercase mb-1">ZIP / Postal Code</label>
                <input type="text" id="shipping-zip" required class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none uppercase" />
              </div>
            </div>
          </div>

          <!-- Payment Details -->
          <div class="flex flex-col gap-3">
            <h3 class="font-mono text-xs font-bold uppercase tracking-widest text-black/40 border-b border-black/5 pb-1">
              2. PAYMENT METHOD
            </h3>

            <div>
              <label for="payment-card" class="block font-mono text-[9px] text-black/60 uppercase mb-1">Card Number</label>
              <input type="text" id="payment-card" placeholder="0000 0000 0000 0000" maxlength="19" required class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none" />
            </div>

            <div class="grid grid-cols-2 gap-2">
              <div>
                <label for="payment-expiry" class="block font-mono text-[9px] text-black/60 uppercase mb-1">Expiry Date</label>
                <input type="text" id="payment-expiry" placeholder="MM/YY" maxlength="5" required class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none" />
              </div>
              <div>
                <label for="payment-cvc" class="block font-mono text-[9px] text-black/60 uppercase mb-1">CVC / CVV</label>
                <input type="text" id="payment-cvc" placeholder="000" maxlength="4" required class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none" />
              </div>
            </div>
          </div>

          <!-- Total summary -->
          <div class="border border-black p-4 bg-zinc-50 font-mono text-xs mt-2">
            <div class="flex justify-between items-center font-black uppercase text-sm">
              <span>Amount Due</span>
              <span id="checkout-amount-due">₹0.00</span>
            </div>
          </div>

          <!-- Submit Button -->
          <button 
            type="submit" 
            id="place-order-btn"
            class="w-full bg-black text-white font-black py-4 uppercase text-xs tracking-widest hover:bg-zinc-950 transition-colors"
          >
            PLACE ORDER & PAY
          </button>
        </form>
      </div>

      <!-- Success Screen (Hidden by default) -->
      <div id="success-container" class="hidden text-center py-16 flex flex-col items-center gap-6">
        <div class="w-16 h-16 bg-black text-white rounded-full flex items-center justify-center text-3xl font-bold animate-scale-up">
          ✓
        </div>
        <div>
          <span class="text-[9px] font-mono text-black/40 uppercase tracking-widest font-bold">Transaction Complete</span>
          <h2 class="text-3xl font-black uppercase tracking-tight leading-none mt-1">ORDER CONFIRMED</h2>
          <p class="text-xs font-mono text-black/60 mt-3 uppercase max-w-[285px] leading-relaxed">
            Thank you for shopping with JerseySports. Your jersey is being custom-tailored and will ship shortly.
          </p>
        </div>
        
        <a 
          href="/" 
          class="w-full max-w-xs text-center py-4 bg-black text-white font-black uppercase text-xs tracking-widest hover:bg-zinc-950 transition-colors"
        >
          RETURN TO HOME
        </a>
      </div>

    </div>
  </div>
</Layout>

<style>
  @keyframes scaleUp {
    0% { transform: scale(0.8); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }
  .animate-scale-up {
    animation: scaleUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script>
  const form = document.getElementById("checkout-form") as HTMLFormElement | null;
  const cardInput = document.getElementById("payment-card") as HTMLInputElement | null;
  const expiryInput = document.getElementById("payment-expiry") as HTMLInputElement | null;
  const cvcInput = document.getElementById("payment-cvc") as HTMLInputElement | null;
  const amountDisplay = document.getElementById("checkout-amount-due");
  const formContainer = document.getElementById("checkout-form-container");
  const successContainer = document.getElementById("success-container");

  // Format Card Number
  cardInput?.addEventListener("input", (e: any) => {
    let val = e.target.value.replace(/\D/g, "");
    let matches = val.match(/\d{4,16}/g);
    let match = (matches && matches[0]) || "";
    let parts = [];

    for (let i = 0, len = match.length; i < len; i += 4) {
      parts.push(match.substring(i, i + 4));
    }

    if (parts.length > 0) {
      e.target.value = parts.join(" ");
    } else {
      e.target.value = val;
    }
  });

  // Format Expiry
  expiryInput?.addEventListener("input", (e: any) => {
    let val = e.target.value.replace(/\D/g, "");
    if (val.length >= 2) {
      e.target.value = val.substring(0, 2) + "/" + val.substring(2, 4);
    } else {
      e.target.value = val;
    }
  });

  // Format CVC
  cvcInput?.addEventListener("input", (e: any) => {
    e.target.value = e.target.value.replace(/\D/g, "");
  });

  const apiURL = import.meta.env.PUBLIC_API_URL || "http://localhost:5000/api";
  let deliveryCharge = 0;
  let customDeliveryCharge = 0;

  async function fetchCharges() {
    try {
      const res = await fetch(`${apiURL}/homepage`);
      const data = await res.json();
      if (res.ok && data.homepage) {
        deliveryCharge = data.homepage.deliveryCharge || 0;
        customDeliveryCharge = data.homepage.customDeliveryCharge || 0;
      }
    } catch (e) {
      console.error("Failed to load delivery charges", e);
    }
  }

  // Calculate order total
  async function loadTotal() {
    try {
      await fetchCharges();
      const cart = JSON.parse(localStorage.getItem("mono_cart") || "[]");
      if (cart.length === 0 && (!successContainer || successContainer.classList.contains("hidden"))) {
        // Empty cart, go back to cart page
        window.location.href = "/cart";
        return;
      }
      const subtotal = cart.reduce((sum: number, item: any) => sum + (item.price * item.quantity), 0);
      const isAnyCustomized = cart.some((item: any) => item.isCustomized === true);
      const charge = isAnyCustomized ? customDeliveryCharge : deliveryCharge;
      const finalTotal = subtotal + charge;

      if (amountDisplay) amountDisplay.textContent = `₹${finalTotal.toFixed(2)}`;
    } catch (e) {
      console.error(e);
    }
  }

  // Handle Checkout submission
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    
    // Simple validation check
    if (!form.checkValidity()) return;

    const placeBtn = document.getElementById("place-order-btn");
    const originalText = placeBtn ? placeBtn.textContent : "";
    if (placeBtn) {
      placeBtn.textContent = "PROCESSING ORDER... ◌";
      (placeBtn as HTMLButtonElement).disabled = true;
    }

    try {
      const cart = JSON.parse(localStorage.getItem("mono_cart") || "[]");
      const subtotal = cart.reduce((sum: number, item: any) => sum + (item.price * item.quantity), 0);
      const isAnyCustomized = cart.some((item: any) => item.isCustomized === true);
      const charge = isAnyCustomized ? customDeliveryCharge : deliveryCharge;
      const finalTotal = subtotal + charge;

      // Update backend stock
      try {
        const purchaseItems = cart.map((item: any) => ({
          id: item.id,
          size: item.size,
          quantity: item.quantity
        }));

        await fetch(`${apiURL}/products/purchase`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ items: purchaseItems })
        });
      } catch (err) {
        console.error("Failed to update stock:", err);
      }

      const orderNumber = "JS-" + Math.floor(100000 + Math.random() * 900000);
      const orderDate = new Date().toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" });

      const newOrder = {
        orderId: orderNumber,
        date: orderDate,
        status: "PROCESSING",
        amount: finalTotal,
        shippingCharge: charge,
        items: cart
      };

      const existingOrders = JSON.parse(localStorage.getItem("mono_orders") || "[]");
      existingOrders.unshift(newOrder);
      localStorage.setItem("mono_orders", JSON.stringify(existingOrders));
    } catch (err) {
      console.error("Failed to save order:", err);
    }

    // Simulate success
    localStorage.removeItem("mono_cart");
    window.dispatchEvent(new Event("cartUpdated"));

    formContainer?.classList.add("hidden");
    successContainer?.classList.remove("hidden");

    if (placeBtn) {
      placeBtn.textContent = originalText;
      (placeBtn as HTMLButtonElement).disabled = false;
    }
  });

  loadTotal();
</script>
