---
import Layout from "./_Layout.astro";
---

<Layout title="JerseySports | Your Shopping Cart">
  <div class="px-4 py-8 select-none bg-white min-h-[70vh]">
    <div class="max-w-md mx-auto">
      <!-- Title -->
      <div class="flex items-end justify-between border-b border-black pb-4 mb-6">
        <div>
          <span class="text-[9px] font-mono text-black/40 uppercase tracking-widest font-bold">Shopping Bag</span>
          <h2 class="text-3xl font-black uppercase tracking-tight leading-none mt-1">YOUR CART</h2>
        </div>
        <a href="/shop" class="text-xs font-mono tracking-widest hover:text-black/60 transition-colors uppercase border-b border-black pb-0.5">
          ADD ITEMS
        </a>
      </div>

      <!-- Cart Items Container -->
      <div id="cart-list" class="flex flex-col gap-4">
        <!-- Dynamically populated by JS -->
        <div class="text-center py-16 text-xs font-mono text-black/40 uppercase">
          Loading your cart...
        </div>
      </div>

      <!-- Order Summary Card -->
      <div id="cart-summary" class="border border-black p-4 mt-8 bg-zinc-50 hidden">
        <h4 class="font-mono text-[10px] font-bold tracking-widest text-black/40 uppercase mb-3">Order Summary</h4>
        
        <div class="flex flex-col gap-2 font-mono text-xs border-b border-black/10 pb-3">
          <div class="flex justify-between">
            <span class="text-black/60 uppercase">Subtotal</span>
            <span id="summary-subtotal" class="font-bold">₹0.00</span>
          </div>
          <div class="flex justify-between">
            <span class="text-black/60 uppercase">Shipping</span>
            <span class="font-bold text-green-700 uppercase">FREE</span>
          </div>
        </div>

        <div class="flex justify-between items-center font-mono text-sm font-black uppercase mt-3">
          <span>Total</span>
          <span id="summary-total">₹0.00</span>
        </div>

        <a 
          href="/checkout"
          class="block w-full text-center bg-black text-white font-black py-4 uppercase text-xs tracking-widest hover:bg-zinc-950 mt-6 transition-colors"
        >
          PROCEED TO CHECKOUT
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  const cartList = document.getElementById("cart-list");
  const cartSummary = document.getElementById("cart-summary");
  const subtotalDisplay = document.getElementById("summary-subtotal");
  const totalDisplay = document.getElementById("summary-total");

  function renderCart() {
    if (!cartList) return;

    try {
      const cart = JSON.parse(localStorage.getItem("mono_cart") || "[]");

      if (cart.length === 0) {
        cartList.innerHTML = `
          <div class="text-center py-16 flex flex-col items-center gap-4">
            <p class="font-mono text-xs text-black/40 uppercase">Your cart is currently empty.</p>
            <a href="/shop" class="px-6 py-3 border border-black text-xs font-mono font-bold tracking-widest uppercase hover:bg-black hover:text-white transition-colors">
              SHOP JERSEYS
            </a>
          </div>
        `;
        cartSummary?.classList.add("hidden");
        return;
      }

      cartSummary?.classList.remove("hidden");
      cartList.innerHTML = "";

      let subtotal = 0;

      cart.forEach((item: any) => {
        subtotal += item.price * item.quantity;

        const div = document.createElement("div");
        div.className = "flex items-center gap-4 border border-black p-3 bg-white";
        div.innerHTML = `
          <!-- Mini preview of jersey representation based on pattern -->
          <div class="w-16 h-16 flex-shrink-0 bg-zinc-50 border border-black/5 p-1 relative flex items-center justify-center">
            <!-- Custom back details preview -->
            <div class="text-center select-none scale-[0.3]">
              <div class="font-mono text-[10px] font-black uppercase text-black leading-none truncate w-24">${item.customName}</div>
              <div class="font-bold text-[32px] text-black leading-none">${item.customNumber}</div>
            </div>
          </div>

          <!-- Info -->
          <div class="flex-grow min-w-0 flex flex-col justify-between h-full">
            <div>
              <div class="flex justify-between items-start">
                <h4 class="font-bold text-xs tracking-tight uppercase truncate pr-2">${item.name}</h4>
                <span class="font-mono text-xs font-bold shrink-0">₹${item.price * item.quantity}</span>
              </div>
              <p class="text-[9px] font-mono text-black/50 uppercase mt-0.5 flex items-center gap-1.5 flex-wrap">
                <span>SIZE: ${item.size}</span>
                <span>|</span>
                <span class="flex items-center gap-1">COLOR: <span class="w-2.5 h-2.5 rounded-full border border-black/20 inline-block" style="background-color: ${item.color || '#000000'}"></span></span>
                <span>|</span>
                <span>NAME: ${item.customName}</span>
                <span>|</span>
                <span>#: ${item.customNumber}</span>
              </p>
            </div>

            <!-- Quantity & Remove Action -->
            <div class="flex justify-between items-center mt-3">
              <div class="flex items-center border border-black">
                <button class="qty-btn-minus px-2 py-0.5 font-mono text-xs hover:bg-zinc-100 border-r border-black" data-id="${item.cartId}">-</button>
                <span class="px-3 py-0.5 font-mono text-xs font-bold">${item.quantity}</span>
                <button class="qty-btn-plus px-2 py-0.5 font-mono text-xs hover:bg-zinc-100 border-l border-black" data-id="${item.cartId}">+</button>
              </div>
              
              <button class="remove-btn font-mono text-[9px] text-red-600 hover:underline uppercase tracking-wider" data-id="${item.cartId}">
                REMOVE
              </button>
            </div>
          </div>
        `;
        cartList.appendChild(div);
      });

      // Update Summary displays
      if (subtotalDisplay) subtotalDisplay.textContent = `₹${subtotal.toFixed(2)}`;
      if (totalDisplay) totalDisplay.textContent = `₹${subtotal.toFixed(2)}`;

      // Attach button events
      attachEvents();

    } catch (e) {
      console.error("Cart render failed", e);
    }
  }

  function attachEvents() {
    // Plus
    document.querySelectorAll(".qty-btn-plus").forEach(btn => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-id");
        updateQty(id, 1);
      });
    });

    // Minus
    document.querySelectorAll(".qty-btn-minus").forEach(btn => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-id");
        updateQty(id, -1);
      });
    });

    // Remove
    document.querySelectorAll(".remove-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-id");
        removeItem(id);
      });
    });
  }

  function updateQty(cartId: string | null, change: number) {
    if (!cartId) return;
    try {
      let cart = JSON.parse(localStorage.getItem("mono_cart") || "[]");
      const idx = cart.findIndex((item: any) => item.cartId === cartId);
      if (idx > -1) {
        cart[idx].quantity += change;
        if (cart[idx].quantity <= 0) {
          cart.splice(idx, 1);
        }
        localStorage.setItem("mono_cart", JSON.stringify(cart));
        renderCart();
        window.dispatchEvent(new Event("cartUpdated"));
      }
    } catch (e) {
      console.error(e);
    }
  }

  function removeItem(cartId: string | null) {
    if (!cartId) return;
    try {
      let cart = JSON.parse(localStorage.getItem("mono_cart") || "[]");
      cart = cart.filter((item: any) => item.cartId !== cartId);
      localStorage.setItem("mono_cart", JSON.stringify(cart));
      renderCart();
      window.dispatchEvent(new Event("cartUpdated"));
    } catch (e) {
      console.error(e);
    }
  }

  // Initial Run
  renderCart();
</script>
