                  <input type="text" id="promo3-title" class="w-full bg-white border border-black px-2 py-1 text-[11px] font-mono focus:outline-none font-bold" />
                  <input type="text" id="promo3-desc" placeholder="Description" class="w-full bg-white border border-black px-2 py-1 text-[11px] font-mono focus:outline-none mt-1" />
                  <input type="text" id="promo3-badge" placeholder="Badge" class="w-full bg-white border border-black px-2 py-1 text-[11px] font-mono focus:outline-none mt-1" />
