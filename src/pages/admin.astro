<script src="https://cdn.jsdelivr.net/npm/chart.js" is:inline></script>

<script define:vars={{ apiURL }}>
  window.addEventListener("DOMContentLoaded", () => {
    
    // NAVIGATION TAB ROUTING LOGIC
    const navDashboard = document.getElementById("nav-dashboard");
    const navInventory = document.getElementById("nav-inventory");
    const navOrders = document.getElementById("nav-orders");
    const navCms = document.getElementById("nav-cms");

    const secDashboard = document.getElementById("sec-dashboard");
    const secInventory = document.getElementById("sec-inventory");
    const secOrders = document.getElementById("sec-orders");
    const secCms = document.getElementById("sec-cms");
    const secCustomers = document.getElementById("sec-customers");

    const navButtons = [navDashboard, navInventory, navOrders, navCms];
    const secViews = [secDashboard, secInventory, secOrders, secCms, secCustomers];

    function showSection(targetSec, activeNav) {
      secViews.forEach(s => s?.classList.add("hidden"));
      targetSec?.classList.remove("hidden");

      navButtons.forEach(n => {
        n?.classList.remove("bg-black", "text-white");
        n?.classList.add("text-black/60", "hover:bg-zinc-100");
      });
      activeNav?.classList.add("bg-black", "text-white");
      activeNav?.classList.remove("text-black/60", "hover:bg-zinc-100");
    }

    navDashboard?.addEventListener("click", (e) => {
      e.preventDefault();
      showSection(secDashboard, navDashboard);
    });
    navInventory?.addEventListener("click", (e) => {
      e.preventDefault();
      showSection(secInventory, navInventory);
    });
    navOrders?.addEventListener("click", (e) => {
      e.preventDefault();
      showSection(secOrders, navOrders);
    });
    navCms?.addEventListener("click", (e) => {
      e.preventDefault();
      showSection(secCms, navCms);
    });

    // --------------------------------------------
    // SYSTEM LOGIN & AUTHORIZATION LOGIC
    // --------------------------------------------
    const loginForm = document.getElementById("admin-login-form");
    const adminUsernameInput = document.getElementById("admin-username");
    const adminPasswordInput = document.getElementById("admin-password");
    const loginError = document.getElementById("login-error");
    const loginSection = document.getElementById("admin-login-sec");
    const panelSection = document.getElementById("admin-panel-sec");
    const lockBtn = document.getElementById("admin-lock-btn");

    const addForm = document.getElementById("add-product-form");
    const pName = document.getElementById("p-name");
    const pPrice = document.getElementById("p-price");
    const pComparePrice = document.getElementById("p-compare-price");
    const pCategory = document.getElementById("p-category");
    const customCategoryContainer = document.getElementById("custom-category-container");
    const pCustomCategory = document.getElementById("p-custom-category");
    const pImageFile = document.getElementById("p-image-file");
    const stockS = document.getElementById("stock-s");
    const stockM = document.getElementById("stock-m");
    const stockL = document.getElementById("stock-l");
    const stockXl = document.getElementById("stock-xl");
    const stockXxl = document.getElementById("stock-xxl");
    const pDesc = document.getElementById("p-desc");
    const pColors = document.getElementById("p-colors");
    const adminToast = document.getElementById("admin-toast");
    const tableBody = document.getElementById("analytics-table-body");
    const customerTableBody = document.getElementById("customer-table-body");

    pCategory?.addEventListener("change", () => {
      if (pCategory.value === "__NEW__") {
        customCategoryContainer?.classList.remove("hidden");
        pCustomCategory?.setAttribute("required", "true");
      } else {
        customCategoryContainer?.classList.add("hidden");
        pCustomCategory?.removeAttribute("required");
      }
    });

    const toggleBulkBtn = document.getElementById("toggle-bulk-btn");
    const bulkUploadContainer = document.getElementById("bulk-upload-container");
    const bulkJsonInput = document.getElementById("bulk-json-input");
    const bulkImportBtn = document.getElementById("bulk-import-btn");

    const ADMIN_USER = "admin";
    const ADMIN_PASS = "admin123";

    function getBase64(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = () => resolve(reader.result);
        reader.onerror = error => reject(error);
      });
    }

    function checkSession() {
      if (sessionStorage.getItem("admin_authorized") === "true") {
        loginSection?.classList.add("hidden");
        panelSection?.classList.remove("hidden");
        renderAnalytics();
        renderHomepageCMS();
      }
    }

    loginForm?.addEventListener("submit", (e) => {
      e.preventDefault();
      const loginBtn = loginForm.querySelector("button[type='submit']");
      const originalText = loginBtn ? loginBtn.textContent : "";
      if (loginBtn) {
        loginBtn.textContent = "AUTHORIZING... ◌";
        loginBtn.disabled = true;
      }

      setTimeout(() => {
        try {
          if (
            adminUsernameInput && 
            adminPasswordInput && 
            adminUsernameInput.value.trim().toLowerCase() === ADMIN_USER && 
            adminPasswordInput.value.trim() === ADMIN_PASS
          ) {
            sessionStorage.setItem("admin_authorized", "true");
            loginSection?.classList.add("hidden");
            panelSection?.classList.remove("hidden");
            if (loginError) loginError.classList.add("hidden");
            adminUsernameInput.value = "";
            adminPasswordInput.value = "";
            renderAnalytics();
            renderHomepageCMS();
          } else {
            if (loginError) loginError.classList.remove("hidden");
          }
        } catch (err) {
          console.error("Authorization error:", err);
          if (loginError) loginError.classList.remove("hidden");
        } finally {
          if (loginBtn) {
            loginBtn.textContent = originalText;
            loginBtn.disabled = false;
          }
        }
      }, 600);
    });

    toggleBulkBtn?.addEventListener("click", () => {
      const isHidden = bulkUploadContainer?.classList.contains("hidden");
      if (isHidden) {
        bulkUploadContainer?.classList.remove("hidden");
        toggleBulkBtn.textContent = "HIDE BULK UPLOAD";
      } else {
        bulkUploadContainer?.classList.add("hidden");
        toggleBulkBtn.textContent = "SHOW BULK UPLOAD (JSON)";
      }
    });

    bulkImportBtn?.addEventListener("click", async () => {
      if (!bulkJsonInput) return;
      const textVal = bulkJsonInput.value.trim();
      if (!textVal) {
        alert("Please paste some JSON products array first.");
        return;
      }

      let parsed = [];
      try {
        parsed = JSON.parse(textVal);
        if (!Array.isArray(parsed)) {
          throw new Error("JSON must be a root array of products.");
        }
      } catch (e) {
        alert("Invalid JSON: " + e.message);
        return;
      }

      const processedProducts = parsed.map((p) => {
        const nameVal = p.name ? p.name.trim() : "UNNAMED JERSEY";
        const slugVal = p.slug || nameVal.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
        
        // Map sizes from string list or object list to schema-compliant objects
        let sizesArray = [];
        if (p.sizes && Array.isArray(p.sizes)) {
          sizesArray = p.sizes.map(s => {
            if (typeof s === "string") {
              return { name: s.toUpperCase(), stock: 50 }; // Default stock 50
            }
            return {
              name: s.name ? s.name.toUpperCase() : "M",
              stock: s.stock !== undefined ? parseInt(s.stock, 10) : 50
            };
          });
        } else {
          sizesArray = [
            { name: "S", stock: 50 },
            { name: "M", stock: 50 },
            { name: "L", stock: 50 },
            { name: "XL", stock: 50 },
            { name: "XXL", stock: 50 }
          ];
        }

        // Map colors from string list or object list to schema-compliant objects
        let colorsArray = [];
        const colorHexMap = {
          red: "#dc2626",
          blue: "#2563eb",
          black: "#18181b",
          white: "#ffffff",
          green: "#16a34a",
          gold: "#d97706",
          "sky blue": "#38bdf8",
          maroon: "#7f1d1d",
          orange: "#f97316",
          purple: "#7c3aed",
          navy: "#1e3a8a",
          crimson: "#991b1b",
          yellow: "#eab308"
        };
        if (p.colors && Array.isArray(p.colors)) {
          colorsArray = p.colors.map(c => {
            if (typeof c === "string") {
              const hex = colorHexMap[c.toLowerCase().trim()] || "#71717a";
              return { name: c, hex };
            }
            return {
              name: c.name || "Default",
              hex: c.hex || "#71717a"
            };
          });
        } else {
          colorsArray = [{ name: "Default White", hex: "#ffffff" }];
        }

        return {
          name: nameVal.toUpperCase(),
          slug: slugVal,
          category: p.category || "Club",
          price: parseInt(p.price, 10) || 0,
          compareAtPrice: p.compareAtPrice ? parseInt(p.compareAtPrice, 10) : undefined,
          badge: p.badge || "LIMITED",
          description: p.description || "Premium quality sportswear jersey.",
          features: p.features || ["100% Premium polyester", "Moisture wicking", "Reinforced stitching"],
          images: p.images && Array.isArray(p.images) ? p.images : ["solid-white"],
          colors: colorsArray,
          sizes: sizesArray,
          featured: p.featured !== undefined ? p.featured : true,
          isActive: p.isActive !== undefined ? p.isActive : true
        };
      });

      const originalText = bulkImportBtn.textContent;
      bulkImportBtn.textContent = "PUBLISHING BULK... ◌";
      bulkImportBtn.disabled = true;

      try {
        const response = await fetch(`${apiURL}/admin/products/bulk`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify(processedProducts)
        });

        const resData = await response.json();
        if (!response.ok) {
          throw new Error(resData.message || "Bulk publication failed.");
        }

        alert(`${resData.products.length} products published successfully in bulk!`);
        bulkJsonInput.value = "";
        bulkUploadContainer?.classList.add("hidden");
        toggleBulkBtn.textContent = "SHOW BULK UPLOAD (JSON)";
        renderAnalytics();
      } catch (err) {
        alert("Failed bulk publishing: " + err.message);
      } finally {
        bulkImportBtn.textContent = originalText;
        bulkImportBtn.disabled = false;
      }
    });

    lockBtn?.addEventListener("click", () => {
      sessionStorage.removeItem("admin_authorized");
      panelSection?.classList.add("hidden");
      loginSection?.classList.remove("hidden");
    });

    // --------------------------------------------
    // PRODUCT CREATION/EDIT FORM SUBMIT
    // --------------------------------------------
    addForm?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const mode = addForm.getAttribute("data-mode") || "add";
      const editId = addForm.getAttribute("data-edit-id") || "";

      const btn = addForm.querySelector("button[type='submit']");
      const originalText = btn.textContent;
      btn.textContent = mode === "edit" ? "UPDATING JERSEY... ◌" : "PUBLISHING JERSEY... ◌";
      btn.disabled = true;

      try {
        const fileList = pImageFile.files;
        const base64Images = [];

        for (let i = 0; i < fileList.length; i++) {
          const b64 = await getBase64(fileList[i]);
          base64Images.push(b64);
        }

        const sizeObj = [
          { name: "S", stock: parseInt(stockS.value, 10) || 0 },
          { name: "M", stock: parseInt(stockM.value, 10) || 0 },
          { name: "L", stock: parseInt(stockL.value, 10) || 0 },
          { name: "XL", stock: parseInt(stockXl.value, 10) || 0 },
          { name: "XXL", stock: parseInt(stockXxl.value, 10) || 0 }
        ];

        const colorHexMap = {
          red: "#dc2626",
          blue: "#2563eb",
          black: "#18181b",
          white: "#ffffff",
          green: "#16a34a",
          gold: "#d97706",
          "sky blue": "#38bdf8",
          maroon: "#7f1d1d",
          orange: "#f97316",
          purple: "#7c3aed",
          navy: "#1e3a8a",
          crimson: "#991b1b",
          yellow: "#eab308"
        };
        
        let colorsArray = [{ name: "Default White", hex: "#ffffff" }];
        if (pColors && pColors.value.trim()) {
          colorsArray = pColors.value.split(",").map(c => {
            const name = c.trim();
            const hex = colorHexMap[name.toLowerCase()] || "#71717a";
            return { name, hex };
          });
        }

        let selectedCategory = pCategory.value;
        if (selectedCategory === "__NEW__") {
          selectedCategory = pCustomCategory.value.trim();
          if (!selectedCategory) {
            throw new Error("Please specify the custom category name.");
          }
        }

        const payload = {
          name: pName.value.trim().toUpperCase(),
          price: parseFloat(pPrice.value),
          compareAtPrice: pComparePrice.value ? parseFloat(pComparePrice.value) : undefined,
          category: selectedCategory,
          description: pDesc.value.trim(),
          colors: colorsArray,
          sizes: sizeObj
        };

        if (base64Images.length > 0) {
          payload.images = base64Images;
        }

        let res;
        if (mode === "edit") {
          res = await fetch(`${apiURL}/admin/products/${editId}`, {
            method: "PUT",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify(payload)
          });
        } else {
          // Add mode requires at least one image
          if (base64Images.length === 0) {
            throw new Error("Product pictures are required to publish.");
          }
          res = await fetch(`${apiURL}/products`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify(payload)
          });
        }

        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.message || "Failed to submit product");
        }

        if (adminToast) {
          adminToast.textContent = mode === "edit" ? "Jersey updated successfully!" : "Jersey added successfully!";
          adminToast.classList.remove("hidden");
          setTimeout(() => adminToast.classList.add("hidden"), 3000);
        }

        addForm.reset();
        addForm.removeAttribute("data-mode");
        addForm.removeAttribute("data-edit-id");
        pImageFile.setAttribute("required", "true");

        // Restore original form title & button text
        const formTitle = addForm.previousElementSibling;
        if (formTitle) {
          formTitle.innerHTML = `
            <span class="material-symbols-outlined text-lg">add_circle</span>
            ADD NEW JERSEY
          `;
        }
        if (btn) {
          btn.innerHTML = `
            <span class="material-symbols-outlined text-[16px]">publish</span>
            PUBLISH TO STORE
          `;
        }

        renderAnalytics();

      } catch (err) {
        console.error(err);
        alert("Failed to save jersey: " + err.message);
      } finally {
        btn.disabled = false;
      }
    });

    // --------------------------------------------
    // RENDER LOCALSTORAGE ORDERS ACTIVITY
    // --------------------------------------------
    function renderAdminOrders() {
      const activeOrdersContainer = document.getElementById("admin-active-orders");
      const completedOrdersContainer = document.getElementById("admin-completed-orders");
      if (!activeOrdersContainer || !completedOrdersContainer) return;

      try {
        const existingOrders = JSON.parse(localStorage.getItem("mono_orders") || "[]");

        activeOrdersContainer.innerHTML = "";
        completedOrdersContainer.innerHTML = "";

        const activeList = existingOrders.filter(o => o.status !== "FINISHED" && o.status !== "CANCELLED");
        const archivedList = existingOrders.filter(o => o.status === "FINISHED" || o.status === "CANCELLED");

        if (activeList.length === 0) {
          activeOrdersContainer.innerHTML = `<div class="p-4 border border-dashed border-black/20 text-center font-mono text-[10px] text-black/40">NO ACTIVE INCOMING ORDERS FOUND.</div>`;
        } else {
          activeList.forEach((order) => {
            const tr = document.createElement("div");
            tr.className = "border border-black p-4 bg-white flex flex-col justify-between hover:border-black transition-colors bg-white font-mono text-[9px] uppercase";
            
            const itemNames = order.items.map(item => `${item.name} (${item.size}) x${item.quantity}`).join(', ');
            const customizationInfo = order.items.map(item => {
              if (item.customName && item.customName !== "MONO") {
                return `[NAME: ${item.customName} / #: ${item.customNumber}]`;
              }
              return "";
            }).filter(Boolean).join(" | ") || "NONE";

            const badgeStyle = order.status === "SHIPPING TRANSIT" ? "text-amber-700 bg-amber-50 border-amber-200" : "text-zinc-600 bg-zinc-50 border-zinc-200";

            tr.innerHTML = `
              <div class="flex justify-between items-start mb-3">
                <div>
                  <p class="font-bold text-[11px] text-black">ORDER #${order.orderId} | TOTAL: ₹${order.amount.toFixed(2)}</p>
                  <p class="text-black/55 mt-0.5">Customer: ${order.customerName} (${order.customerPhone})</p>
                  <p class="text-black/45 mt-0.5">Jerseys: ${itemNames}</p>
                  <p class="text-black/45 mt-0.5">Customizations: ${customizationInfo}</p>
                </div>
                <span class="border px-2.5 py-1 rounded-sm uppercase tracking-wider font-bold shrink-0 ${badgeStyle}">
                  ${order.status}
                </span>
              </div>
              <div class="flex gap-2 pt-2 border-t border-dashed border-black/10 mt-2">
                <button class="transit-btn border border-black/15 bg-zinc-50 px-2 py-1 font-bold hover:bg-black hover:text-white transition-colors" data-id="${order.orderId}">TRANSIT</button>
                <button class="deliver-btn border border-black/15 bg-zinc-50 px-2 py-1 font-bold hover:bg-black hover:text-white transition-colors" data-id="${order.orderId}">DELIVER</button>
                <button class="cancel-btn border border-red-200 text-red-600 bg-red-50 px-2 py-1 font-bold hover:bg-red-600 hover:text-white transition-colors" data-id="${order.orderId}">CANCEL</button>
              </div>
            `;
            activeOrdersContainer.appendChild(tr);
          });
        }

        if (archivedList.length === 0) {
          completedOrdersContainer.innerHTML = `<div class="p-4 border border-dashed border-black/20 text-center font-mono text-[10px] text-black/40">NO COMPLETED OR CANCELLED ORDERS.</div>`;
        } else {
          completedOrdersContainer.innerHTML = archivedList.map((order) => {
            const itemNames = order.items.map(item => `${item.name} (${item.size}) x${item.quantity}`).join(', ');
            const customizationInfo = order.items.map(item => {
              if (item.customName && item.customName !== "MONO") {
                return `[NAME: ${item.customName} / #: ${item.customNumber}]`;
              }
              return "";
            }).filter(Boolean).join(" | ") || "NONE";

            const badgeStyle = order.status === "FINISHED" ? "text-green-700 bg-green-50 border-green-200" : "text-red-700 bg-red-50 border-red-200";

            return `
              <div class="flex justify-between items-center p-3 border border-black/10 bg-zinc-50/30 w-full opacity-70">
                <div class="font-mono text-[10px] uppercase">
                  <p class="font-bold text-black/50">ORDER #${order.orderId} | Total: ₹${order.amount.toFixed(2)}</p>
                  <p class="text-black/40 mt-0.5">Jerseys: ${itemNames}</p>
                  <p class="text-black/40 mt-0.5">Customization: ${customizationInfo}</p>
                </div>
                <span class="font-mono text-[8px] font-bold border px-2 py-1 rounded-sm uppercase shrink-0 ${badgeStyle}">
                  ${order.status}
                </span>
              </div>
            `;
          }).join('');
        }

        // Action Buttons binding
        document.querySelectorAll(".transit-btn").forEach(btn => {
          btn.addEventListener("click", () => {
            updateStatus(btn.getAttribute("data-id"), "SHIPPING TRANSIT");
          });
        });

        document.querySelectorAll(".deliver-btn").forEach(btn => {
          btn.addEventListener("click", () => {
            updateStatus(btn.getAttribute("data-id"), "DELIVERED");
          });
        });



        document.querySelectorAll(".cancel-btn").forEach(btn => {
          btn.addEventListener("click", () => {
            if (confirm("Are you sure you want to cancel this order?")) {
              updateStatus(btn.getAttribute("data-id"), "CANCELLED");
            }
          });
        });

        function updateStatus(orderId, newStatus) {
          if (!orderId) return;
          const existingOrders = JSON.parse(localStorage.getItem("mono_orders") || "[]");
          const target = existingOrders.find(o => o.orderId === orderId);
          if (target) {
            target.status = newStatus;
            localStorage.setItem("mono_orders", JSON.stringify(existingOrders));
            renderAdminOrders();
          }
        }

      } catch (e) {
        console.error(e);
      }
    }

    // --------------------------------------------
    // RENDER REGISTERED CUSTOMERS LIST
    // --------------------------------------------
    async function renderCustomers() {
      if (!customerTableBody) return;
      try {
        const response = await fetch(`${apiURL}/users/admin/users`);
        const data = await response.json();
        
        if (!response.ok) {
          throw new Error(data.message || "Failed to fetch users");
        }

        const usersList = data.users || [];
        customerTableBody.innerHTML = "";

        if (usersList.length === 0) {
          customerTableBody.innerHTML = `<tr><td colspan="3" class="py-4 text-center font-mono text-[10px] text-black/40">NO CUSTOMERS REGISTERED YET.</td></tr>`;
          return;
        }

        usersList.forEach(u => {
          const tr = document.createElement("tr");
          tr.className = "border-b border-black/5 hover:bg-zinc-50/50";
          const dateStr = new Date(u.createdAt).toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" });
          
          tr.innerHTML = `
            <td class="py-3 pr-2 font-bold uppercase text-black">${u.name}</td>
            <td class="py-3 pr-2 text-black/60">${u.email}</td>
            <td class="py-3 text-right text-black/40">${dateStr}</td>
          `;
          customerTableBody.appendChild(tr);
        });
      } catch (err) {
        console.error(err);
        customerTableBody.innerHTML = `<tr><td colspan="3" class="py-4 text-center font-mono text-[10px] text-red-600 font-bold">ERROR LOADING CUSTOMERS: ${err.message.toUpperCase()}</td></tr>`;
      }
    }

    // --------------------------------------------
    // RENDER PRODUCT STATISTICS & DRAW CHARTS
    // --------------------------------------------
    let bestSellersChartInstance = null;
    let categoryChartInstance = null;

    async function renderAnalytics() {
      if (!tableBody) return;

      try {
        tableBody.innerHTML = `<tr><td colspan="8" class="py-4 text-center font-mono text-[10px] text-black/40">LOADING DATA...</td></tr>`;

        const response = await fetch(`${apiURL}/admin/products?limit=4000`);
        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || "Failed to fetch products");
        }

        const productsList = data.products || [];

        // Dynamic category dropdown options populating
        const uniqueCategories = ["Club", "International", "Retro", "Custom"];
        productsList.forEach(p => {
          if (p.category && !uniqueCategories.includes(p.category)) {
            uniqueCategories.push(p.category);
          }
        });

        const originalSelectValue = pCategory.value;
        pCategory.innerHTML = "";
        uniqueCategories.forEach(cat => {
          const opt = document.createElement("option");
          opt.value = cat;
          opt.textContent = cat.toUpperCase();
          opt.style.color = "#000000";
          opt.style.backgroundColor = "#ffffff";
          pCategory.appendChild(opt);
        });
        
        const optNew = document.createElement("option");
        optNew.value = "__NEW__";
        optNew.textContent = "+ CREATE NEW CATEGORY...";
        optNew.style.color = "#000000";
        optNew.style.backgroundColor = "#ffffff";
        pCategory.appendChild(optNew);

        if (uniqueCategories.includes(originalSelectValue)) {
          pCategory.value = originalSelectValue;
        } else {
          pCategory.value = uniqueCategories[0] || "";
        }
        if (customCategoryContainer) customCategoryContainer.classList.add("hidden");
        if (pCustomCategory) {
          pCustomCategory.removeAttribute("required");
          pCustomCategory.value = "";
        }

        // Dynamic stats counters
        let totalRevenue = 0;
        let totalOrders = 0;
        let totalViews = 0;

        productsList.forEach((p) => {
          totalRevenue += p.price * (p.totalSold || 0);
          totalOrders += p.totalSold || 0;
          totalViews += p.views || 0;
        });

        const averageVal = totalOrders > 0 ? Math.round(totalRevenue / totalOrders) : 0;
        const convRate = totalViews > 0 ? ((totalOrders / totalViews) * 100).toFixed(2) : "0.00";

        const statRev = document.getElementById("stat-revenue");
        const statOrd = document.getElementById("stat-orders");
        const statConv = document.getElementById("stat-conversion");
        const statAvgVal = document.getElementById("stat-average-val");

        if (statRev) statRev.textContent = `₹${totalRevenue.toLocaleString()}`;
        if (statOrd) statOrd.textContent = `${totalOrders} items`;
        if (statConv) statConv.textContent = `${convRate}%`;
        if (statAvgVal) statAvgVal.textContent = `₹${averageVal.toLocaleString()}`;

        renderAdminOrders();
        renderCustomers();

        const deleteSelectedBtn = document.getElementById("delete-selected-btn");
        const selectAllProducts = document.getElementById("select-all-products");

        if (selectAllProducts) selectAllProducts.checked = false;
        if (deleteSelectedBtn) deleteSelectedBtn.classList.add("hidden");

        tableBody.innerHTML = "";

        if (productsList.length === 0) {
          tableBody.innerHTML = `<tr><td colspan="9" class="py-4 text-center font-mono text-[10px] text-black/40">NO PRODUCTS FOUND. PUBLISH SOME JERSEYS!</td></tr>`;
          return;
        }

        productsList.forEach((p) => {
          const tr = document.createElement("tr");
          tr.className = "border-b border-black/5 hover:bg-zinc-50/50";
          
          const actionHtml = `
            <button class="edit-p-btn text-black font-bold hover:underline mr-2.5" data-id="${p._id}">EDIT</button>
            <button class="delete-p-btn text-red-600 font-bold hover:underline" data-id="${p._id}">DELETE</button>
          `;
          const growth = p.totalSold > 100 ? "+24.2%" : p.totalSold > 0 ? "+8.4%" : "+0%";
          const growthColor = "text-green-600";

          // Calculate total stock
          const totalStock = p.sizes ? p.sizes.reduce((acc, s) => acc + (s.stock || 0), 0) : 0;
          let stockHtml = "";
          if (totalStock === 0) {
            stockHtml = `<span class="text-red-600 font-bold">OUT OF STOCK</span>`;
          } else if (totalStock <= 5) {
            stockHtml = `<span class="text-amber-600 font-bold">LOW STOCK (${totalStock})</span>`;
          } else {
            stockHtml = `<span class="text-green-600">IN STOCK (${totalStock})</span>`;
          }

          tr.innerHTML = `
            <td class="py-3.5 pr-2 w-6"><input type="checkbox" class="product-select-checkbox cursor-pointer" data-id="${p._id}" /></td>
            <td class="py-3.5 pr-2 font-bold uppercase truncate max-w-[150px] text-black">${p.name}</td>
            <td class="py-3.5 pr-2 uppercase text-black/60">${p.category}</td>
            <td class="py-3.5 pr-2 text-right text-black font-bold">₹${p.price}</td>
            <td class="py-3.5 pr-2 text-right font-bold">${stockHtml}</td>
            <td class="py-3.5 pr-2 text-right text-black/65">${p.views || 0}</td>
            <td class="py-3.5 pr-2 text-right text-black/65">${p.totalSold || 0}</td>
            <td class="py-3.5 pr-2 text-right font-bold ${growthColor}">${growth}</td>
            <td class="py-3.5 text-right font-bold">${actionHtml}</td>
          `;
          tableBody.appendChild(tr);
        });

        // Toggle state function for bulk delete button
        function updateDeleteSelectedBtn() {
          const checkedCheckboxes = document.querySelectorAll(".product-select-checkbox:checked");
          const count = checkedCheckboxes.length;
          if (count > 0) {
            deleteSelectedBtn?.classList.remove("hidden");
            if (deleteSelectedBtn) deleteSelectedBtn.textContent = `DELETE SELECTED (${count})`;
          } else {
            deleteSelectedBtn?.classList.add("hidden");
          }
        }

        // Select All listener
        selectAllProducts?.addEventListener("change", () => {
          const isChecked = selectAllProducts.checked;
          document.querySelectorAll(".product-select-checkbox").forEach((cb) => {
            cb.checked = isChecked;
          });
          updateDeleteSelectedBtn();
        });

        // Individual checkbox change listener
        document.querySelectorAll(".product-select-checkbox").forEach((cb) => {
          cb.addEventListener("change", () => {
            const total = document.querySelectorAll(".product-select-checkbox").length;
            const checked = document.querySelectorAll(".product-select-checkbox:checked").length;
            if (selectAllProducts) {
              selectAllProducts.checked = (total === checked && total > 0);
            }
            updateDeleteSelectedBtn();
          });
        });

        // Bulk delete click action
        deleteSelectedBtn?.addEventListener("click", async () => {
          const checkedCheckboxes = document.querySelectorAll(".product-select-checkbox:checked");
          const ids = Array.from(checkedCheckboxes).map((cb) => cb.getAttribute("data-id"));
          if (ids.length === 0) return;

          if (!confirm(`Are you sure you want to delete the ${ids.length} selected products?`)) return;

          deleteSelectedBtn.textContent = "DELETING... ◌";
          deleteSelectedBtn.disabled = true;

          try {
            await Promise.all(ids.map(async (id) => {
              const res = await fetch(`${apiURL}/admin/products/${id}`, {
                method: "DELETE"
              });
              if (!res.ok) {
                throw new Error(`Failed to delete product ID ${id}`);
              }
            }));

            alert("Selected products deleted successfully!");
            renderAnalytics();
          } catch (err) {
            alert("Error during bulk delete: " + err.message);
          } finally {
            deleteSelectedBtn.disabled = false;
            deleteSelectedBtn.classList.add("hidden");
          }
        });

        // Edit handlers
        document.querySelectorAll(".edit-p-btn").forEach(btn => {
          btn.addEventListener("click", () => {
            const id = btn.getAttribute("data-id");
            if (!id) return;

            const p = productsList.find(item => item._id === id);
            if (!p) return;

            // Populate form fields
            pName.value = p.name || "";
            pPrice.value = p.price || 0;
            pComparePrice.value = p.compareAtPrice || "";
            pCategory.value = p.category || "";
            pDesc.value = p.description || "";

            // Populate sizes
            const sizeMap = {};
            if (p.sizes) {
              p.sizes.forEach(s => {
                sizeMap[s.name] = s.stock || 0;
              });
            }
            stockS.value = sizeMap["S"] !== undefined ? sizeMap["S"] : 0;
            stockM.value = sizeMap["M"] !== undefined ? sizeMap["M"] : 0;
            stockL.value = sizeMap["L"] !== undefined ? sizeMap["L"] : 0;
            stockXl.value = sizeMap["XL"] !== undefined ? sizeMap["XL"] : 0;
            stockXxl.value = sizeMap["XXL"] !== undefined ? sizeMap["XXL"] : 0;

            // Populate colors
            if (p.colors) {
              pColors.value = p.colors.map(c => c.name).join(", ");
            } else {
              pColors.value = "";
            }

            // Set edit mode
            addForm.setAttribute("data-mode", "edit");
            addForm.setAttribute("data-edit-id", id);

            // Update form header
            const formTitle = addForm.previousElementSibling;
            if (formTitle) {
              formTitle.innerHTML = `
                <span class="material-symbols-outlined text-lg">edit</span>
                EDIT JERSEY
              `;
            }

            // Update submit button text
            const submitBtn = addForm.querySelector("button[type='submit']");
            if (submitBtn) {
              submitBtn.innerHTML = `
                <span class="material-symbols-outlined text-[16px]">save</span>
                UPDATE JERSEY
              `;
            }

            pImageFile.removeAttribute("required");
            addForm.scrollIntoView({ behavior: "smooth" });
          });
        });

        // Delete handlers
        document.querySelectorAll(".delete-p-btn").forEach(btn => {
          btn.addEventListener("click", async () => {
            const id = btn.getAttribute("data-id");
            if (!id) return;

            if (!confirm("Are you sure you want to delete this product?")) return;

            try {
              const delRes = await fetch(`${apiURL}/admin/products/${id}`, {
                method: "DELETE"
              });
              const delData = await delRes.json();

              if (!delRes.ok) {
                throw new Error(delData.message || "Failed to delete product");
              }

              renderAnalytics();
            } catch (err) {
              alert("Error deleting product: " + err.message);
            }
          });
        });

        // Render Chart.js visuals
        try {
          if (typeof Chart !== "undefined") {
            if (bestSellersChartInstance) bestSellersChartInstance.destroy();
            if (categoryChartInstance) categoryChartInstance.destroy();

            // 1. Best Sellers Bar Chart
            const sortedForChart = [...productsList].sort((a, b) => (b.totalSold || 0) - (a.totalSold || 0)).slice(0, 5);
            const labels = sortedForChart.map(p => p.name);
            const dataSales = sortedForChart.map(p => p.totalSold || 0);

            const ctxBest = document.getElementById("bestsellers-chart");
            if (ctxBest) {
              bestSellersChartInstance = new Chart(ctxBest, {
                type: 'bar',
                data: {
                  labels: labels,
                  datasets: [{
                    label: 'JERSEYS SOLD',
                    data: dataSales,
                    backgroundColor: ['#2563eb', '#dc2626', '#16a34a', '#d97706', '#7c3aed'],
                    borderColor: ['#1e40af', '#991b1b', '#15803d', '#b45309', '#6d28d9'],
                    borderWidth: 1
                  }]
                },
                options: {
                  indexAxis: 'y',
                  responsive: true,
                  maintainAspectRatio: false,
                  plugins: { legend: { display: false } },
                  scales: {
                    x: { beginAtZero: true, grid: { display: false } },
                    y: { grid: { display: false } }
                  }
                }
              });
            }

            // 2. Category Pie/Doughnut Chart
            const categoriesMap = {};
            productsList.forEach(p => {
              const cat = p.category || "Club";
              categoriesMap[cat] = (categoriesMap[cat] || 0) + (p.totalSold || 0);
            });

            const catLabels = Object.keys(categoriesMap);
            const catData = Object.values(categoriesMap);

            const ctxCat = document.getElementById("category-chart");
            if (ctxCat) {
              categoryChartInstance = new Chart(ctxCat, {
                type: 'doughnut',
                data: {
                  labels: catLabels,
                  datasets: [{
                    data: catData,
                    backgroundColor: ['#2563eb', '#dc2626', '#16a34a', '#d97706', '#7c3aed', '#db2777', '#0891b2', '#4f46e5'],
                    borderWidth: 1
                  }]
                },
                options: {
                  responsive: true,
                  maintainAspectRatio: false,
                  plugins: {
                    legend: {
                      position: 'right',
                      labels: {
                        boxWidth: 10,
                        font: { size: 8 }
                      }
                    }
                  }
                }
              });
            }
          }
        } catch (chartErr) {
          console.error("Failed to render Chart.js graphics:", chartErr);
        }

      } catch (err) {
        console.error(err);
        tableBody.innerHTML = `<tr><td colspan="7" class="py-4 text-center font-mono text-[10px] text-red-600 font-bold">ERROR LOADING DATA: ${err.message.toUpperCase()}</td></tr>`;
      }
    }

    // --------------------------------------------
    // CMS HOMEPAGE BANNERS & SETTINGS
    // --------------------------------------------
    let currentHomepageData = null;

    async function renderHomepageCMS() {
      try {
        const response = await fetch(`${apiURL}/homepage`);
        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || "Failed to load homepage data");
        }

        const hp = data.homepage;
        currentHomepageData = hp;

        // Headings
        document.getElementById("heading-featured-title").value = hp.sectionHeadings?.featured?.title || "FEATURED JERSEYS";
        document.getElementById("heading-featured-subtitle").value = hp.sectionHeadings?.featured?.subtitle || "LATEST STORE ARRIVALS";
        document.getElementById("heading-bestsellers-title").value = hp.sectionHeadings?.bestsellers?.title || "BEST SELLERS";
        document.getElementById("heading-bestsellers-subtitle").value = hp.sectionHeadings?.bestsellers?.subtitle || "MOST POPULAR DESIGNS";

        // Delivery Charges
        document.getElementById("delivery-charge").value = hp.deliveryCharge || 0;
        document.getElementById("custom-delivery-charge").value = hp.customDeliveryCharge || 0;

        // Promotions
        const promo1 = hp.promotions?.[0] || { title: "", description: "", badge: "", buttonLink: "" };
        const promo2 = hp.promotions?.[1] || { title: "", description: "", badge: "", buttonLink: "" };
        const promo3 = hp.promotions?.[2] || { title: "", description: "", badge: "" };

        document.getElementById("promo1-badge").value = promo1.badge || "";
        document.getElementById("promo1-title").value = promo1.title || "";
        document.getElementById("promo1-desc").value = promo1.description || "";
        document.getElementById("promo1-link").value = promo1.buttonLink || "";

        document.getElementById("promo2-badge").value = promo2.badge || "";
        document.getElementById("promo2-title").value = promo2.title || "";
        document.getElementById("promo2-desc").value = promo2.description || "";
        document.getElementById("promo2-link").value = promo2.buttonLink || "";

        document.getElementById("promo3-badge").value = promo3.badge || "";
        document.getElementById("promo3-title").value = promo3.title || "";
        document.getElementById("promo3-desc").value = promo3.description || "";

        // Category grid
        const catContainer = document.getElementById("cms-categories-list");
        if (catContainer) {
          catContainer.innerHTML = "";
          for (let i = 0; i < 3; i++) {
            const cat = hp.categories?.[i] || { name: "", imageUrl: "", link: "" };
            catContainer.innerHTML += `
              <div class="border border-black/15 p-2 bg-white flex flex-col gap-1 text-[9px] uppercase font-mono">
                <span class="font-bold text-black/50">Category ${i + 1}</span>
                <div>
                  <label class="block text-[8px] text-black/55 mb-0.5">Name</label>
                  <input type="text" id="cat-name-${i}" value="${cat.name}" class="w-full bg-white border border-black px-2 py-0.5 text-[11px] font-mono focus:outline-none" />
                </div>
                <div>
                  <label class="block text-[8px] text-black/55 mb-0.5">Image URL / Style</label>
                  <input type="text" id="cat-img-${i}" value="${cat.imageUrl}" class="w-full bg-white border border-black px-2 py-0.5 text-[11px] font-mono focus:outline-none" />
                </div>
                <div>
                  <label class="block text-[8px] text-black/55 mb-0.5">Link</label>
                  <input type="text" id="cat-link-${i}" value="${cat.link}" class="w-full bg-white border border-black px-2 py-0.5 text-[11px] font-mono focus:outline-none" />
                </div>
              </div>
            `;
          }
        }

        // CTA
        document.getElementById("cta-title").value = hp.cta?.title || "";
        document.getElementById("cta-desc").value = hp.cta?.description || "";
        document.getElementById("cta-btn-text").value = hp.cta?.buttonText || "";
        document.getElementById("cta-btn-link").value = hp.cta?.buttonLink || "";

        // Hero slides list
        const heroContainer = document.getElementById("cms-hero-list");
        if (heroContainer) {
          heroContainer.innerHTML = "";
          if ((hp.heroSlides || []).length === 0) {
            heroContainer.innerHTML = `<div class="p-3 border border-dashed border-black/20 text-center text-black/40 text-[9px] font-mono">No hero slides found. Add one!</div>`;
          } else {
            hp.heroSlides.forEach((slide) => {
              const activeLabel = slide.isActive ? "ACTIVE" : "INACTIVE";
              const activeColor = slide.isActive ? "text-green-700 bg-green-50 border-green-200" : "text-black/45 bg-zinc-100 border-zinc-300";
              const patternText = slide.imageUrl.length > 50 ? "Uploaded File" : slide.imageUrl;
              
              const isRealImg = slide.imageUrl.length > 50 || slide.imageUrl.startsWith("http");
              const imageContent = isRealImg 
                ? `<img src="${slide.imageUrl}" alt="Slide Preview" class="w-10 h-10 object-cover border border-black/10 rounded-sm shrink-0" />`
                : `<div class="w-10 h-10 flex items-center justify-center border border-black/10 rounded-sm bg-zinc-50 font-bold font-mono text-[7px] text-black/50 shrink-0 select-none">${slide.imageUrl.replace("solid-", "").replace("-stripes", "")}</div>`;

              heroContainer.innerHTML += `
                <div class="border border-black p-3 bg-white flex justify-between items-center font-mono text-[9px] uppercase">
                  <div class="flex items-center gap-3">
                    ${imageContent}
                    <div>
                      <p class="font-bold text-[10px] text-black">${slide.title}</p>
                      <p class="text-black/55 mt-0.5">Eyebrow: ${slide.eyebrow} | Image: ${patternText}</p>
                      <p class="text-black/40 mt-0.5">Link: ${slide.buttonLink} | Order: ${slide.displayOrder}</p>
                    </div>
                  </div>
                  <div class="flex items-center gap-2">
                    <button type="button" class="toggle-hero-status-btn border px-2 py-1 font-bold ${activeColor} hover:bg-black hover:text-white transition-colors" data-id="${slide._id}" data-active="${slide.isActive}">${activeLabel}</button>
                    <button type="button" class="delete-hero-btn border border-red-200 text-red-600 bg-red-50 hover:bg-red-600 hover:text-white transition-colors px-2 py-1 font-bold" data-id="${slide._id}">DELETE</button>
                  </div>
                </div>
              `;
            });

            // Toggle active slide click handler
            document.querySelectorAll(".toggle-hero-status-btn").forEach(btn => {
              btn.addEventListener("click", async () => {
                const id = btn.getAttribute("data-id");
                const currentActive = btn.getAttribute("data-active") === "true";
                try {
                  const res = await fetch(`${apiURL}/admin/homepage/hero/${id}`, {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ isActive: !currentActive })
                  });
                  if (!res.ok) throw new Error("Status update failed");
                  renderHomepageCMS();
                } catch (err) {
                  alert(err.message);
                }
              });
            });

            // Delete slide handler
            document.querySelectorAll(".delete-hero-btn").forEach(btn => {
              btn.addEventListener("click", async () => {
                if (!confirm("Are you sure you want to delete this hero slide?")) return;
                const id = btn.getAttribute("data-id");
                try {
                  const res = await fetch(`${apiURL}/admin/homepage/hero/${id}`, {
                    method: "DELETE"
                  });
                  if (!res.ok) throw new Error("Delete failed");
                  renderHomepageCMS();
                } catch (err) {
                  alert(err.message);
                }
              });
            });
          }
        }

      } catch (error) {
        console.error(error);
      }
    }

    // --------------------------------------------
    // CMS HERO SLIDE FORM HANDLER & DISPLAY
    // --------------------------------------------
    const cmsAddHeroBtn = document.getElementById("cms-add-hero-btn");
    const cmsCancelHeroBtn = document.getElementById("cms-cancel-hero-btn");
    const cmsHeroFormContainer = document.getElementById("cms-hero-form-container");
    const cmsHeroForm = document.getElementById("cms-hero-form");

    cmsAddHeroBtn?.addEventListener("click", () => {
      cmsHeroFormContainer?.classList.remove("hidden");
    });
    cmsCancelHeroBtn?.addEventListener("click", () => {
      cmsHeroFormContainer?.classList.add("hidden");
      cmsHeroForm.reset();
    });

    cmsHeroForm?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const btn = cmsHeroForm.querySelector("button[type='submit']");
      const originalText = btn.textContent;
      btn.textContent = "SAVING SLIDE... ◌";
      btn.disabled = true;

      try {
        const fileEl = document.getElementById("new-hero-image-file");
        const patternEl = document.getElementById("new-hero-image-pattern");

        let imgUrl = patternEl.value.trim() || "solid-white";

        if (fileEl && fileEl.files.length > 0) {
          imgUrl = await getBase64(fileEl.files[0]);
        }

        const payload = {
          eyebrow: document.getElementById("new-hero-eyebrow").value.trim(),
          title: document.getElementById("new-hero-title").value.trim(),
          description: document.getElementById("new-hero-desc").value.trim(),
          buttonText: document.getElementById("new-hero-btn-text").value.trim() || "SHOP NOW",
          buttonLink: document.getElementById("new-hero-btn-link").value.trim() || "/shop",
          imageUrl: imgUrl,
          displayOrder: parseInt(document.getElementById("new-hero-order").value, 10) || 0
        };

        const res = await fetch(`${apiURL}/admin/homepage/hero`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });

        if (!res.ok) {
          throw new Error("Failed to add hero slide");
        }

        cmsHeroFormContainer?.classList.add("hidden");
        cmsHeroForm.reset();
        renderHomepageCMS();

      } catch (err) {
        alert(err.message);
      } finally {
        btn.textContent = originalText;
        btn.disabled = false;
      }
    });

    // --------------------------------------------
    // CMS GENERAL CMS SUBMIT SETTINGS
    // --------------------------------------------
    const generalForm = document.getElementById("cms-general-form");
    generalForm?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const promotions = [];
      for (let i = 1; i <= 3; i++) {
        const titleEl = document.getElementById(`promo${i}-title`);
        const titleVal = titleEl ? titleEl.value.trim() : "";
        if (titleVal) {
          promotions.push({
            title: titleVal,
            description: document.getElementById(`promo${i}-desc`).value.trim(),
            badge: document.getElementById(`promo${i}-badge`).value.trim(),
            buttonText: i === 3 ? "SHOP GUARANTEE" : "EXPLORE",
            buttonLink: i === 3 ? "/shop" : (document.getElementById(`promo${i}-link`)?.value?.trim() || "/shop")
          });
        }
      }

      const categoriesArray = [];
      for (let i = 0; i < 3; i++) {
        const nameEl = document.getElementById(`cat-name-${i}`);
        const nameVal = nameEl ? nameEl.value.trim() : "";
        if (nameVal) {
          categoriesArray.push({
            name: nameVal,
            imageUrl: document.getElementById(`cat-img-${i}`).value.trim(),
            link: document.getElementById(`cat-link-${i}`).value.trim()
          });
        }
      }

      const payload = {
        deliveryCharge: parseFloat(document.getElementById("delivery-charge").value) || 0,
        customDeliveryCharge: parseFloat(document.getElementById("custom-delivery-charge").value) || 0,
        sectionHeadings: {
          featured: {
            title: document.getElementById("heading-featured-title").value.trim(),
            subtitle: document.getElementById("heading-featured-subtitle").value.trim()
          },
          bestsellers: {
            title: document.getElementById("heading-bestsellers-title").value.trim(),
            subtitle: document.getElementById("heading-bestsellers-subtitle").value.trim()
          }
        },
        promotions,
        categories: categoriesArray,
        cta: {
          title: document.getElementById("cta-title").value.trim(),
          description: document.getElementById("cta-desc").value.trim(),
          buttonText: document.getElementById("cta-btn-text").value.trim(),
          buttonLink: document.getElementById("cta-btn-link").value.trim()
        }
      };

      try {
        const res = await fetch(`${apiURL}/admin/homepage`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });

        if (!res.ok) {
          throw new Error("Failed to update homepage settings");
        }

        alert("Homepage settings updated successfully!");
        renderHomepageCMS();
      } catch (err) {
        alert("Error saving settings: " + err.message);
      }
    });

    // Check session on load
    checkSession();
  });
</script>
