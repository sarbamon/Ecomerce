---
import Layout from "./_Layout.astro";
import { categories } from "../data/products";

const apiURL = import.meta.env.PUBLIC_API_URL || "http://localhost:5000/api";
---

<Layout title="JerseySports Console | Admin" fullWidth={true}>
  <!-- Style overrides for native selects -->
  <style is:global>
    select, select option {
      color: #000000 !important;
      background-color: #ffffff !important;
    }
  </style>

  <!-- External Resources -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Anybody:wght@700;800&family=Archivo+Narrow:wght@600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>

  <!-- Admin Login Sec (Visible until authorization) -->
  <div id="admin-login-sec" class="max-w-md mx-auto w-full py-24 px-4 flex flex-col gap-6 selection:bg-black selection:text-white font-mono">
    <div class="flex flex-col border-b border-black pb-4 mb-2">
      <span class="text-[9px] text-black/40 uppercase tracking-widest font-bold font-mono">Console Authorization</span>
      <h2 class="text-3xl font-black uppercase tracking-tight leading-none mt-1 font-sans">ADMIN PORTAL</h2>
    </div>

    <form id="admin-login-form" class="flex flex-col gap-4" onsubmit="event.preventDefault();">
      <div>
        <label for="admin-username" class="block text-[9px] text-black/60 uppercase mb-1 font-bold">Username</label>
        <input 
          type="text" 
          id="admin-username" 
          placeholder="ADMIN" 
          required 
          class="w-full bg-white border border-black px-3 py-2 text-xs focus:outline-none rounded-none" 
        />
      </div>
      <div>
        <label for="admin-password" class="block text-[9px] text-black/60 uppercase mb-1 font-bold">Password</label>
        <input 
          type="password" 
          id="admin-password" 
          placeholder="••••••••" 
          required 
          class="w-full bg-white border border-black px-3 py-2 text-xs focus:outline-none rounded-none" 
        />
      </div>
      <div id="login-error" class="text-red-600 font-bold text-[10px] hidden uppercase text-center">
        Access Denied. Invalid credentials.
      </div>
      <button 
        type="submit" 
        class="w-full bg-black text-white font-black py-3.5 uppercase text-xs tracking-widest hover:bg-zinc-950 transition-colors rounded-none"
      >
        AUTHORIZE
      </button>
    </form>
  </div>

  <!-- Admin Panel Dashboard Wrapper (Hidden until login) -->
  <div id="admin-panel-sec" class="hidden min-h-screen w-full flex bg-slate-50 text-black selection:bg-black selection:text-white">
    
    <!-- Left Sidebar -->
    <aside class="bg-white docked left-0 h-screen w-64 border-r border-black fixed left-0 top-0 flex flex-col pt-6 z-50 select-none">
      <div class="px-6 mb-8">
        <h2 class="font-sans text-2xl font-black text-black uppercase tracking-tight">CONSOLE</h2>
        <span class="font-mono text-[8px] text-black/40 uppercase tracking-widest block mt-1 font-bold">ADMINISTRATIVE DASHBOARD</span>
      </div>
      
      <nav class="flex-grow flex flex-col gap-1">
        <a id="nav-dashboard" class="flex items-center gap-4 bg-black text-white font-bold px-6 py-3 border-r-4 border-transparent transition-all cursor-pointer font-mono" href="#">
          <span class="material-symbols-outlined text-[20px]">dashboard</span>
          <span class="text-[10px] uppercase tracking-wider">Dashboard</span>
        </a>
        <a id="nav-inventory" class="flex items-center gap-4 text-black/60 hover:text-black px-6 py-3 hover:bg-zinc-100 transition-all border-r-4 border-transparent hover:border-black cursor-pointer font-mono" href="#">
          <span class="material-symbols-outlined text-[20px]">inventory_2</span>
          <span class="text-[10px] uppercase tracking-wider">Inventory</span>
        </a>
        <a id="nav-orders" class="flex items-center gap-4 text-black/60 hover:text-black px-6 py-3 hover:bg-zinc-100 transition-all border-r-4 border-transparent hover:border-black cursor-pointer font-mono" href="#">
          <span class="material-symbols-outlined text-[20px]">shopping_cart</span>
          <span class="text-[10px] uppercase tracking-wider">Orders</span>
        </a>
        <a id="nav-cms" class="flex items-center gap-4 text-black/60 hover:text-black px-6 py-3 hover:bg-zinc-100 transition-all border-r-4 border-transparent hover:border-black cursor-pointer font-mono" href="#">
          <span class="material-symbols-outlined text-[20px]">settings</span>
          <span class="text-[10px] uppercase tracking-wider">CMS Settings</span>
        </a>
      </nav>
      
      <div class="p-6 border-t border-black/10">
        <button id="admin-lock-btn" class="w-full border border-black hover:bg-black hover:text-white text-black font-bold py-3 transition-colors uppercase tracking-widest text-[9px] flex items-center justify-center gap-2 font-mono">
          <span class="material-symbols-outlined text-[16px]">logout</span>
          LOG OUT
        </button>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-grow ml-64 min-h-screen flex flex-col bg-zinc-50/50">
      
      <!-- Top Navigation -->
      <nav class="bg-white border-b border-black/15 flex justify-between items-center w-full px-8 py-4 sticky top-0 z-40">
        <div class="flex items-center gap-4 select-none">
          <span class="font-sans text-xl font-extrabold tracking-tighter text-black uppercase">JERSEY SPORTS</span>
        </div>
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2 border border-green-700/25 px-3 py-1 bg-green-50">
            <span class="w-1.5 h-1.5 rounded-full bg-green-600 animate-pulse"></span>
            <span class="font-mono text-[9px] text-green-700 uppercase font-bold tracking-wider">LIVE SYNC ACTIVE</span>
          </div>
        </div>
      </nav>

      <!-- Main Dashboard Scrollable Content -->
      <div class="w-full px-8 py-8 flex flex-col gap-6">

        <!-- 1. SECTION: DASHBOARD (Default Tab View) -->
        <div id="sec-dashboard" class="flex flex-col gap-6">
          <header class="flex flex-col justify-between select-none">
            <h1 class="font-sans text-3xl font-black text-black uppercase">OVERVIEW</h1>
          </header>

          <!-- Metrics Row -->
          <div class="grid grid-cols-4 gap-4">
            <div class="bg-white border border-black/10 p-5 flex flex-col justify-between min-h-[110px] hover:bg-zinc-50/50 transition-colors">
              <span class="font-mono text-[9px] text-black/40 uppercase tracking-wider font-bold">TOTAL SALES REVENUE</span>
              <div class="flex items-end justify-between mt-auto">
                <span id="stat-revenue" class="font-sans text-xl font-bold text-black">₹0</span>
                <span class="font-mono text-[9px] text-green-600 font-bold bg-green-50 px-1 py-0.5 border border-green-100">+24.2%</span>
              </div>
            </div>
            <div class="bg-white border border-black/10 p-5 flex flex-col justify-between min-h-[110px] hover:bg-zinc-50/50 transition-colors">
              <span class="font-mono text-[9px] text-black/40 uppercase tracking-wider font-bold">ACTIVE ORDERS</span>
              <div class="flex items-end justify-between mt-auto">
                <span id="stat-orders" class="font-sans text-xl font-bold text-black">0 items</span>
                <span class="font-mono text-[9px] text-green-600 font-bold bg-green-50 px-1 py-0.5 border border-green-100">+12.5%</span>
              </div>
            </div>
            <div class="bg-white border border-black/10 p-5 flex flex-col justify-between min-h-[110px] hover:bg-zinc-50/50 transition-colors">
              <span class="font-mono text-[9px] text-black/40 uppercase tracking-wider font-bold">CONVERSION RATE</span>
              <div class="flex items-end justify-between mt-auto">
                <span id="stat-conversion" class="font-sans text-xl font-bold text-black">0.00%</span>
                <span class="font-mono text-[9px] text-black/40 font-bold bg-zinc-100 px-1 py-0.5 border border-zinc-200">Stable</span>
              </div>
            </div>
            <div class="bg-white border border-black/10 p-5 flex flex-col justify-between min-h-[110px] hover:bg-zinc-50/50 transition-colors">
              <span class="font-mono text-[9px] text-black/40 uppercase tracking-wider font-bold">AVERAGE ORDER VAL</span>
              <div class="flex items-end justify-between mt-auto">
                <span id="stat-average-val" class="font-sans text-xl font-bold text-black">₹0</span>
                <span class="font-mono text-[9px] text-green-600 font-bold bg-green-50 px-1 py-0.5 border border-green-100">+4.8%</span>
              </div>
            </div>
          </div>

          <!-- Charts Grid -->
          <div class="grid grid-cols-2 gap-4">
            <div class="border border-black/10 p-5 bg-white flex flex-col gap-2">
              <h4 class="font-mono text-xs font-black uppercase tracking-wider border-b border-black/10 pb-2 mb-2">TOP SELLING PRODUCTS</h4>
              <div class="h-[200px] relative">
                <canvas id="bestsellers-chart"></canvas>
              </div>
            </div>
            <div class="border border-black/10 p-5 bg-white flex flex-col gap-2">
              <h4 class="font-mono text-xs font-black uppercase tracking-wider border-b border-black/10 pb-2 mb-2">SALES BY CATEGORY</h4>
              <div class="h-[200px] relative">
                <canvas id="category-chart"></canvas>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. SECTION: INVENTORY (Inventory & Form Tab) -->
        <div id="sec-inventory" class="hidden grid grid-cols-12 gap-6 items-start">
          
          <!-- Add Product Form -->
          <div class="col-span-4 border border-black/10 p-6 bg-white flex flex-col gap-4">
            <h3 class="font-mono text-sm font-black uppercase tracking-wider border-b border-black pb-2 flex items-center gap-2">
              <span class="material-symbols-outlined text-lg">add_circle</span>
              ADD NEW JERSEY
            </h3>
            <form id="add-product-form" class="flex flex-col gap-4" onsubmit="event.preventDefault();">
              <div>
                <label for="p-name" class="block font-mono text-[8px] text-black/60 uppercase mb-1 font-bold">Jersey Name</label>
                <input type="text" id="p-name" required placeholder="E.G. CHAMPION STRIPE" class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none uppercase rounded-none" />
              </div>
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label for="p-price" class="block font-mono text-[8px] text-black/60 uppercase mb-1 font-bold">Price (₹)</label>
                  <input type="number" id="p-price" required placeholder="1899" class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none rounded-none" />
                </div>
                <div>
                  <label for="p-compare-price" class="block font-mono text-[8px] text-black/60 uppercase mb-1 font-bold">Compare-At / Offer (₹)</label>
                  <input type="number" id="p-compare-price" placeholder="2499" class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none rounded-none" />
                </div>
              </div>
              <div>
                <label for="p-category" class="block font-mono text-[8px] text-black/60 uppercase mb-1 font-bold">Category</label>
                <select id="p-category" required class="w-full bg-white border border-black px-3 py-2 text-xs font-mono text-black focus:outline-none rounded-none">
                  <!-- Dynamically populated in JavaScript -->
                </select>
                <div id="custom-category-container" class="mt-2 hidden">
                  <label for="p-custom-category" class="block font-mono text-[8px] text-black/60 uppercase mb-1 font-bold">Custom Category Name</label>
                  <input type="text" id="p-custom-category" placeholder="E.G. CRICKET" class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none rounded-none" />
                </div>
              </div>
              <div>
                <label for="p-image-file" class="block font-mono text-[8px] text-black/60 uppercase mb-1 font-bold">Product Pictures (1 to 4 files)</label>
                <input type="file" id="p-image-file" accept="image/*" multiple required class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none rounded-none" />
              </div>
              <div>
                <label for="p-colors" class="block font-mono text-[8px] text-black/60 uppercase mb-1 font-bold">Jersey Colors (Comma separated, e.g. Red, Blue, Black)</label>
                <input type="text" id="p-colors" placeholder="E.G. RED, WHITE" class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none rounded-none uppercase" />
              </div>
              
              <div class="border border-black/10 p-3 bg-zinc-50 flex flex-col gap-2">
                <span class="font-mono text-[9px] text-black/40 uppercase font-bold">Size Stock Quantity</span>
                <div class="grid grid-cols-5 gap-1">
                  <div>
                    <label for="stock-s" class="block font-mono text-[7px] text-black/60 uppercase text-center mb-0.5">S</label>
                    <input type="number" id="stock-s" placeholder="0" class="w-full bg-white border border-black py-1 text-center text-[10px] font-mono focus:outline-none rounded-none" />
                  </div>
                  <div>
                    <label for="stock-m" class="block font-mono text-[7px] text-black/60 uppercase text-center mb-0.5">M</label>
                    <input type="number" id="stock-m" placeholder="0" class="w-full bg-white border border-black py-1 text-center text-[10px] font-mono focus:outline-none rounded-none" />
                  </div>
                  <div>
                    <label for="stock-l" class="block font-mono text-[7px] text-black/60 uppercase text-center mb-0.5">L</label>
                    <input type="number" id="stock-l" placeholder="0" class="w-full bg-white border border-black py-1 text-center text-[10px] font-mono focus:outline-none rounded-none" />
                  </div>
                  <div>
                    <label for="stock-xl" class="block font-mono text-[7px] text-black/60 uppercase text-center mb-0.5">XL</label>
                    <input type="number" id="stock-xl" placeholder="0" class="w-full bg-white border border-black py-1 text-center text-[10px] font-mono focus:outline-none rounded-none" />
                  </div>
                  <div>
                    <label for="stock-xxl" class="block font-mono text-[7px] text-black/60 uppercase text-center mb-0.5">XXL</label>
                    <input type="number" id="stock-xxl" placeholder="0" class="w-full bg-white border border-black py-1 text-center text-[10px] font-mono focus:outline-none rounded-none" />
                  </div>
                </div>
              </div>
              <div>
                <label for="p-desc" class="block font-mono text-[8px] text-black/60 uppercase mb-1 font-bold">Product Description</label>
                <textarea id="p-desc" required rows="3" placeholder="PRODUCT DESCRIPTION AND QUALITY SPECS..." class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none uppercase rounded-none"></textarea>
              </div>
              <button type="submit" class="w-full bg-black text-white font-mono text-[10px] font-bold py-3.5 uppercase tracking-widest hover:bg-zinc-900 transition-colors flex items-center justify-center gap-2 rounded-none">
                <span class="material-symbols-outlined text-[16px]">publish</span>
                PUBLISH TO STORE
              </button>
            </form>

            <!-- Bulk Import Button Panel -->
            <div class="border-t border-black/10 pt-4 mt-2 flex flex-col gap-2">
              <h4 class="font-mono text-[10px] text-black/40 uppercase font-black tracking-wider">BULK IMPORT PRODUCTS</h4>
              <button type="button" id="toggle-bulk-btn" class="w-full border border-black py-2.5 font-mono text-[9px] font-bold tracking-wider hover:bg-black hover:text-white transition-all uppercase rounded-none">
                SHOW BULK UPLOAD (JSON)
              </button>
              
              <div id="bulk-upload-container" class="hidden flex flex-col gap-3">
                <p class="font-mono text-[8px] text-black/50 leading-relaxed uppercase">
                  Paste a JSON array of products. Required fields: name, price, description, images (array of URLs or SVG pattern style), sizes (array of [name, stock] objects).
                </p>
                <textarea 
                  id="bulk-json-input" 
                  rows="6" 
                  placeholder='[\n  {\n    "name": "CHELSEA HOME JERSEY",\n    "price": 1899,\n    "description": "Premium fit",\n    "images": ["solid-white"],\n    "sizes": [{"name": "M", "stock": 10}]\n  }\n]'
                  class="w-full bg-white border border-black p-2 text-[10px] font-mono focus:outline-none rounded-none"
                ></textarea>
                <button 
                  type="button" 
                  id="bulk-import-btn"
                  class="w-full bg-black text-white font-black py-3 uppercase text-[10px] tracking-wider hover:bg-zinc-950 transition-colors rounded-none"
                >
                  BULK PUBLISH
                </button>
              </div>
            </div>

            <!-- Toast feedback banner -->
            <div id="admin-toast" class="hidden border border-black p-3 bg-zinc-50 font-mono text-[10px] text-center font-bold tracking-widest uppercase mt-2">
              Jersey added successfully!
            </div>
          </div>

          <!-- Product Performance Table -->
          <div class="col-span-8 border border-black/10 p-6 bg-white overflow-x-auto">
            <div class="flex justify-between items-center border-b border-black pb-2 mb-4">
              <h3 class="font-mono text-sm font-black uppercase tracking-wider">PRODUCT PERFORMANCE ANALYTICS</h3>
              <button id="delete-selected-btn" class="bg-red-600 hover:bg-red-700 text-white font-mono text-[9px] font-bold px-3 py-1.5 uppercase tracking-wider hidden transition-colors rounded-none">
                DELETE SELECTED (0)
              </button>
            </div>
            <table class="w-full font-mono text-[10px] text-left border-collapse">
              <thead>
                <tr class="border-b border-black/10 uppercase text-black/40">
                  <th class="py-2.5 pr-2 w-6"><input type="checkbox" id="select-all-products" class="cursor-pointer" /></th>
                  <th class="py-2.5 font-bold">Jersey Item</th>
                  <th class="py-2.5 font-bold">Category</th>
                  <th class="py-2.5 font-bold text-right">Price</th>
                  <th class="py-2.5 font-bold text-right">Stock</th>
                  <th class="py-2.5 font-bold text-right">Views</th>
                  <th class="py-2.5 font-bold text-right">Orders</th>
                  <th class="py-2.5 font-bold text-right">Growth</th>
                  <th class="py-2.5 font-bold text-right">Action</th>
                </tr>
              </thead>
              <tbody id="analytics-table-body">
                <!-- Dynamically filled product rows -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- 3. SECTION: ORDERS (Order Feeds Tab) -->
        <div id="sec-orders" class="hidden flex flex-col gap-6 bg-white border border-black/10 p-6">
          <div>
            <h3 class="font-mono text-sm font-black uppercase tracking-wider border-b border-black pb-2 mb-4 font-black">ACTIVE CUSTOM ORDERS</h3>
            <div id="admin-active-orders" class="flex flex-col gap-3">
              <!-- Dynamically populated from localStorage Orders -->
            </div>
          </div>
          <div class="pt-6 border-t border-black/15">
            <h3 class="font-mono text-sm font-black uppercase tracking-wider border-b border-black pb-2 mb-4 font-black">COMPLETED & ARCHIVED ORDERS</h3>
            <div id="admin-completed-orders" class="flex flex-col gap-3 opacity-80">
              <!-- Dynamically populated from localStorage Orders -->
            </div>
          </div>
        </div>

        <!-- 4. SECTION: CMS SETTINGS (Hero slides, CMS general text settings) -->
        <div id="sec-cms" class="hidden grid grid-cols-12 gap-6 items-start">
          
          <!-- Hero slides configuration list -->
          <div class="col-span-7 flex flex-col gap-6">
            <div class="border border-black/10 p-6 bg-white flex flex-col gap-4">
              <div class="flex justify-between items-center border-b border-black pb-2">
                <h3 class="font-mono text-sm font-black uppercase tracking-wider">HERO SLIDER SETTINGS</h3>
                <button type="button" id="cms-add-hero-btn" class="bg-black text-white px-3 py-1.5 font-mono text-[9px] uppercase tracking-wider font-bold hover:bg-zinc-950 transition-colors">ADD SLIDE</button>
              </div>

              <!-- Hero Slide Form (Collapsible) -->
              <div id="cms-hero-form-container" class="hidden border border-black p-4 bg-zinc-50 flex flex-col gap-3">
                <h4 class="font-mono text-[10px] font-bold uppercase tracking-wider border-b border-black/15 pb-1 text-black/50">NEW HERO SLIDE DETAILS</h4>
                <form id="cms-hero-form" class="flex flex-col gap-3">
                  <div class="grid grid-cols-2 gap-2">
                    <div>
                      <label class="block font-mono text-[8px] text-black/60 uppercase mb-0.5">Eyebrow (Mini-header)</label>
                      <input type="text" id="new-hero-eyebrow" placeholder="LIMITED RELEASE" class="w-full bg-white border border-black px-2 py-1 text-[11px] font-mono focus:outline-none" />
                    </div>
                    <div>
                      <label class="block font-mono text-[8px] text-black/60 uppercase mb-0.5">Slide Title</label>
                      <input type="text" id="new-hero-title" required placeholder="RETRO COLLECTION" class="w-full bg-white border border-black px-2 py-1 text-[11px] font-mono focus:outline-none font-bold" />
                    </div>
                  </div>
                  <div>
                    <label class="block font-mono text-[8px] text-black/60 uppercase mb-0.5">Description Text</label>
                    <input type="text" id="new-hero-desc" placeholder="Shop the premium stripes archive." class="w-full bg-white border border-black px-2 py-1 text-[11px] font-mono focus:outline-none" />
                  </div>
                  <div class="grid grid-cols-2 gap-2">
                    <div>
                      <label class="block font-mono text-[8px] text-black/60 uppercase mb-0.5">Button Text</label>
                      <input type="text" id="new-hero-btn-text" placeholder="SHOP NOW" class="w-full bg-white border border-black px-2 py-1 text-[11px] font-mono focus:outline-none" />
                    </div>
                    <div>
                      <label class="block font-mono text-[8px] text-black/60 uppercase mb-0.5">Button Link</label>
                      <input type="text" id="new-hero-btn-link" placeholder="/shop" class="w-full bg-white border border-black px-2 py-1 text-[11px] font-mono focus:outline-none" />
                    </div>
                  </div>
                  <div class="grid grid-cols-2 gap-2">
                    <div>
                      <label class="block font-mono text-[8px] text-black/60 uppercase mb-0.5">Hero Image File (Upload)</label>
                      <input type="file" id="new-hero-image-file" accept="image/*" class="w-full bg-white border border-black px-2 py-1 text-[11px] font-mono focus:outline-none" />
                      <input type="text" id="new-hero-image-pattern" placeholder="OR type SVG style (stripes, etc)" class="w-full bg-white border border-black px-2 py-1 text-[11px] font-mono focus:outline-none mt-1" />
                    </div>
                    <div>
                      <label class="block font-mono text-[8px] text-black/60 uppercase mb-0.5">Display Order</label>
                      <input type="number" id="new-hero-order" value="0" class="w-full bg-white border border-black px-2 py-1 text-[11px] font-mono focus:outline-none" />
                    </div>
                  </div>
                  <div class="flex gap-2 pt-2">
                    <button type="submit" class="px-4 py-2 bg-green-700 text-white text-[9px] font-mono font-bold hover:bg-green-800 transition-colors uppercase">Save Slide</button>
                    <button type="button" id="cms-cancel-hero-btn" class="px-4 py-2 border border-black text-black text-[9px] font-mono font-bold hover:bg-zinc-50 transition-colors uppercase">Cancel</button>
                  </div>
                </form>
              </div>

              <!-- Hero Slides Listing -->
              <div id="cms-hero-list" class="flex flex-col gap-3 mt-2">
                <!-- Dynamically populated list -->
              </div>
            </div>
