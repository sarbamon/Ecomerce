                  <input type="text" id="promo2-title" class="w-full bg-white border border-black px-2 py-1 text-[11px] font-mono focus:outline-none font-bold" />
                  <input type="text" id="promo2-desc" placeholder="Description" class="w-full bg-white border border-black px-2 py-1 text-[11px] font-mono focus:outline-none mt-1" />
                  <input type="text" id="promo2-badge" placeholder="Badge" class="w-full bg-white border border-black px-2 py-1 text-[11px] font-mono focus:outline-none mt-1" />
                  <input type="text" id="promo2-link" placeholder="Link" class="w-full bg-white border border-black px-2 py-1 text-[11px] font-mono focus:outline-none mt-1" />
