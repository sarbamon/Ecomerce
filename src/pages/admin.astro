---
import Layout from "./_Layout.astro";
import { categories, products } from "../data/products";

// Full-screen Admin Portal Page with Analytics
---

<Layout title="JerseySports | Admin Dashboard" fullWidth={true}>
  <div class="px-6 py-10 select-none bg-white min-h-[80vh]">
    <!-- Simulator Warning (Shown only on small screens) -->
    <div class="block lg:hidden text-center py-16 px-4 flex flex-col items-center justify-center min-h-[50vh]">
      <div class="w-12 h-12 border border-black flex items-center justify-center font-mono text-lg font-black mb-4">!</div>
      <span class="text-[9px] font-mono text-black/40 uppercase tracking-widest font-bold">Access Restricted</span>
      <h2 class="text-xl font-black uppercase mt-1">DESKTOP REQUIRED</h2>
      <p class="font-mono text-[9px] text-black/60 uppercase mt-4 max-w-[240px] leading-relaxed">
        The administrative console requires a screen resolution of 1024px or wider for full dashboard grid layouts.
      </p>
      <a 
        href="/" 
        class="mt-6 px-6 py-2.5 border border-black font-mono text-[10px] font-bold uppercase tracking-widest hover:bg-black hover:text-white transition-colors"
      >
        RETURN HOME
      </a>
    </div>

    <!-- Authorized Desktop Container -->
    <div class="hidden lg:flex flex-col gap-8 w-full max-w-6xl mx-auto">
      
      <!-- Admin Login State -->
      <div id="admin-login-sec" class="max-w-md mx-auto w-full py-12 flex flex-col gap-6">
        <div class="flex flex-col border-b border-black pb-4 mb-4">
          <span class="text-[9px] font-mono text-black/40 uppercase tracking-widest font-bold">Restricted Area</span>
          <h2 class="text-3xl font-black uppercase tracking-tight leading-none mt-1">ADMIN PORTAL</h2>
        </div>

        <form id="admin-login-form" class="flex flex-col gap-4" onsubmit="event.preventDefault();">
          <div>
            <label for="admin-pin" class="block font-mono text-[9px] text-black/60 uppercase mb-1">Enter Admin PIN</label>
            <input 
              type="password" 
              id="admin-pin" 
              placeholder="••••" 
              required 
              maxlength="6"
              class="w-full bg-white border border-black px-3 py-2 text-center text-lg font-mono focus:outline-none tracking-widest" 
            />
          </div>
          <div id="login-error" class="text-red-600 font-mono text-[10px] hidden uppercase text-center">
            Access Denied. Incorrect PIN.
          </div>
          <button 
            type="submit" 
            class="w-full bg-black text-white font-black py-3.5 uppercase text-xs tracking-widest hover:bg-zinc-950 transition-colors"
          >
            AUTHORIZE
          </button>
        </form>
      </div>

      <!-- Admin Panel Actions (Hidden until login) -->
      <div id="admin-panel-sec" class="hidden flex flex-col gap-8 w-full">
        
        <!-- Header -->
        <div class="flex justify-between items-center border-b border-black pb-4">
          <div>
            <span class="text-[9px] font-mono text-black/40 uppercase tracking-widest font-bold">Administrative Dashboard</span>
            <h1 class="text-4xl font-black uppercase tracking-tight leading-none mt-1">JERSEYSPORTS CONSOLE</h1>
          </div>
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs text-green-700 bg-green-50 border border-green-200 px-2.5 py-1 uppercase font-bold">● Live Sync Active</span>
            <button 
              id="admin-lock-btn" 
              class="px-4 py-2 border border-black text-xs font-mono font-bold tracking-wider hover:bg-black hover:text-white transition-colors uppercase"
            >
              LOCK CONSOLE
            </button>
          </div>
        </div>

        <!-- Metric Cards Grid -->
        <div class="grid grid-cols-4 gap-4">
          <div class="border border-black p-4 bg-zinc-50 flex flex-col justify-between">
            <span class="font-mono text-[10px] text-black/40 uppercase tracking-wider">Total Sales Revenue</span>
            <div class="mt-2 flex items-baseline gap-2">
              <span class="text-2xl font-black">₹4,28,450</span>
              <span class="font-mono text-[10px] text-green-600 font-bold">+24.2%</span>
            </div>
          </div>
          <div class="border border-black p-4 bg-zinc-50 flex flex-col justify-between">
            <span class="font-mono text-[10px] text-black/40 uppercase tracking-wider">Active Orders</span>
            <div class="mt-2 flex items-baseline gap-2">
              <span class="text-2xl font-black">186 items</span>
              <span class="font-mono text-[10px] text-green-600 font-bold">+12.5%</span>
            </div>
          </div>
          <div class="border border-black p-4 bg-zinc-50 flex flex-col justify-between">
            <span class="font-mono text-[10px] text-black/40 uppercase tracking-wider">Conversion Rate</span>
            <div class="mt-2 flex items-baseline gap-2">
              <span class="text-2xl font-black">3.45%</span>
              <span class="font-mono text-[10px] text-black/50 font-bold">Stable</span>
            </div>
          </div>
          <div class="border border-black p-4 bg-zinc-50 flex flex-col justify-between">
            <span class="font-mono text-[10px] text-black/40 uppercase tracking-wider">Average Order Val</span>
            <div class="mt-2 flex items-baseline gap-2">
              <span class="text-2xl font-black">₹2,300</span>
              <span class="font-mono text-[10px] text-green-600 font-bold">+4.8%</span>
            </div>
          </div>
        </div>

        <!-- Two Column Dashboard Layout -->
        <div class="grid grid-cols-12 gap-8 items-start">
          
          <!-- Column 1: Add Jersey Form (Col Span 4) -->
          <div class="col-span-4 border border-black p-6 bg-white flex flex-col gap-6">
            <h3 class="font-mono text-sm font-black uppercase tracking-wider border-b border-black pb-2">ADD NEW JERSEY</h3>
            <form id="add-product-form" class="flex flex-col gap-4" onsubmit="event.preventDefault();">
              <div>
                <label for="p-name" class="block font-mono text-[9px] text-black/60 uppercase mb-1">Jersey Name</label>
                <input type="text" id="p-name" required placeholder="E.G. CHAMPION STRIPE" class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none uppercase" />
              </div>

              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label for="p-price" class="block font-mono text-[9px] text-black/60 uppercase mb-1">Price (₹)</label>
                  <input type="number" id="p-price" required placeholder="1899" class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none" />
                </div>
                <div>
                  <label for="p-category" class="block font-mono text-[9px] text-black/60 uppercase mb-1">Category</label>
                  <select id="p-category" required class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none rounded-none">
                    {categories.filter(c => c !== "All").map(c => (
                      <option value={c}>{c.toUpperCase()}</option>
                    ))}
                  </select>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label for="p-pattern" class="block font-mono text-[9px] text-black/60 uppercase mb-1">Design Pattern</label>
                  <select id="p-pattern" required class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none rounded-none">
                    <option value="vertical-stripes">VERTICAL STRIPES</option>
                    <option value="horizontal-stripes">HORIZONTAL STRIPES</option>
                    <option value="solid-black">STEALTH BLACK</option>
                    <option value="chevron-black">CHEVRON BLACK</option>
                    <option value="solid-white">SOLID WHITE</option>
                    <option value="fine-grid">FINE GRID</option>
                  </select>
                </div>
                <div>
                  <label for="p-badge" class="block font-mono text-[9px] text-black/60 uppercase mb-1">Badge</label>
                  <input type="text" id="p-badge" placeholder="E.G. LIMITED" class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none uppercase" />
                </div>
              </div>

              <div>
                <label for="p-desc" class="block font-mono text-[9px] text-black/60 uppercase mb-1">Product Description</label>
                <textarea id="p-desc" required rows="3" placeholder="PRODUCT SPECIFICATIONS AND TEXTURES..." class="w-full bg-white border border-black px-3 py-2 text-xs font-mono focus:outline-none uppercase"></textarea>
              </div>

              <button 
                type="submit" 
                class="w-full bg-black text-white font-black py-3.5 uppercase text-xs tracking-widest hover:bg-zinc-950 transition-colors mt-2"
              >
                PUBLISH TO STORE
              </button>
            </form>

            <div id="admin-toast" class="hidden border border-black p-3 bg-zinc-50 font-mono text-[10px] text-center font-bold tracking-widest uppercase">
              Jersey added successfully!
            </div>
          </div>

          <!-- Column 2: Product Performance & Growth Analytics (Col Span 8) -->
          <div class="col-span-8 flex flex-col gap-6">
            
            <!-- Products Catalog with Growth Stats -->
            <div class="border border-black p-6 bg-white">
              <h3 class="font-mono text-sm font-black uppercase tracking-wider border-b border-black pb-2 mb-4">PRODUCT PERFORMANCE ANALYTICS</h3>
              
              <div class="overflow-x-auto">
                <table class="w-full font-mono text-[10px] text-left border-collapse">
                  <thead>
                    <tr class="border-b border-black/10 uppercase text-black/40">
                      <th class="py-2.5 font-bold">Jersey Item</th>
                      <th class="py-2.5 font-bold">Category</th>
                      <th class="py-2.5 font-bold text-right">Price</th>
                      <th class="py-2.5 font-bold text-right">Views</th>
                      <th class="py-2.5 font-bold text-right">Orders</th>
                      <th class="py-2.5 font-bold text-right">Growth</th>
                      <th class="py-2.5 font-bold text-right">Action</th>
                    </tr>
                  </thead>
                  <tbody id="analytics-table-body">
                    <!-- Loaded dynamically via JS -->
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Orders Activity Feed -->
            <div class="border border-black p-6 bg-white">
              <h3 class="font-mono text-sm font-black uppercase tracking-wider border-b border-black pb-2 mb-4">REAL-TIME CUSTOM ORDERS</h3>
              <div class="flex flex-col gap-3">
                <div class="flex justify-between items-center p-3 border border-black/10 bg-zinc-50/50">
                  <div class="font-mono text-[10px] uppercase">
                    <p class="font-bold">ORDER #JS-482012 by <span class="underline">AVANTH</span></p>
                    <p class="text-black/50 mt-0.5">Customization: NAME: CHAMP | NUMBER: 07 | Size: L</p>
                  </div>
                  <span class="font-mono text-xs font-bold text-green-700 bg-green-50 border border-green-200 px-2 py-0.5 rounded-sm">COMPLETED</span>
                </div>
                <div class="flex justify-between items-center p-3 border border-black/10 bg-zinc-50/50">
                  <div class="font-mono text-[10px] uppercase">
                    <p class="font-bold">ORDER #JS-482011 by <span class="underline">CHAMP</span></p>
                    <p class="text-black/50 mt-0.5">Customization: NAME: WINNER | NUMBER: 10 | Size: M</p>
                  </div>
                  <span class="font-mono text-xs font-bold text-green-700 bg-green-50 border border-green-200 px-2 py-0.5 rounded-sm">COMPLETED</span>
                </div>
              </div>
            </div>

          </div>

        </div>

      </div>

    </div>
  </div>
</Layout>

<script define:vars={{ products }}>
  const loginForm = document.getElementById("admin-login-form");
  const adminPin = document.getElementById("admin-pin");
  const loginError = document.getElementById("login-error");
  const loginSection = document.getElementById("admin-login-sec");
  const panelSection = document.getElementById("admin-panel-sec");
  const lockBtn = document.getElementById("admin-lock-btn");

  const addForm = document.getElementById("add-product-form");
  const pName = document.getElementById("p-name");
  const pPrice = document.getElementById("p-price");
  const pCategory = document.getElementById("p-category");
  const pPattern = document.getElementById("p-pattern");
  const pBadge = document.getElementById("p-badge");
  const pDesc = document.getElementById("p-desc");
  const adminToast = document.getElementById("admin-toast");
  const tableBody = document.getElementById("analytics-table-body");

  const SECRET_PIN = "0000";

  function checkSession() {
    if (sessionStorage.getItem("admin_authorized") === "true") {
      loginSection?.classList.add("hidden");
      panelSection?.classList.remove("hidden");
      renderAnalytics();
    }
  }

  loginForm?.addEventListener("submit", () => {
    if (adminPin && adminPin.value === SECRET_PIN) {
      sessionStorage.setItem("admin_authorized", "true");
      loginSection?.classList.add("hidden");
      panelSection?.classList.remove("hidden");
      if (loginError) loginError.classList.add("hidden");
      adminPin.value = "";
      renderAnalytics();
    } else {
      if (loginError) loginError.classList.remove("hidden");
    }
  });

  lockBtn?.addEventListener("click", () => {
    sessionStorage.removeItem("admin_authorized");
    panelSection?.classList.add("hidden");
    loginSection?.classList.remove("hidden");
  });

  addForm?.addEventListener("submit", () => {
    if (!pName || !pPrice || !pCategory || !pPattern || !pDesc) return;

    const newProduct = {
      id: "custom-" + Date.now(),
      name: pName.value.trim().toUpperCase(),
      category: pCategory.value,
      price: parseInt(pPrice.value),
      badge: pBadge ? pBadge.value.trim().toUpperCase() : "",
      description: pDesc.value.trim(),
      features: ["100% Premium polyester", "Moisture wicking", "Reinforced stitching"],
      pattern: pPattern.value,
      // Add mock initial analytics
      views: 12,
      orders: 0,
      growth: "+0%"
    };

    try {
      const customList = JSON.parse(localStorage.getItem("custom_products") || "[]");
      customList.push(newProduct);
      localStorage.setItem("custom_products", JSON.stringify(customList));

      addForm.reset();

      if (adminToast) {
        adminToast.classList.remove("hidden");
        setTimeout(() => {
          adminToast.classList.add("hidden");
        }, 2500);
      }

      renderAnalytics();
    } catch (e) {
      console.error(e);
    }
  });

  // Render product rows with statistics
  function renderAnalytics() {
    if (!tableBody) return;

    try {
      const customList = JSON.parse(localStorage.getItem("custom_products") || "[]");
      
      // Seed default products with mock analytics for display
      const seededStaticProducts = products.map((p, idx) => ({
        ...p,
        views: [1420, 940, 810, 1150, 1920, 680][idx % 6],
        orders: [54, 32, 28, 41, 68, 19][idx % 6],
        growth: ["+14.2%", "+8.4%", "+22.1%", "+4.2%", "+31.2%", "-2.5%"][idx % 6]
      }));

      const allProducts = [...seededStaticProducts, ...customList];
      tableBody.innerHTML = "";

      allProducts.forEach((p) => {
        const tr = document.createElement("tr");
        tr.className = "border-b border-black/5 hover:bg-zinc-50/50";
        
        // Show delete button for custom products only
        const isCustom = p.id.toString().startsWith("custom-");
        const actionHtml = isCustom 
          ? `<button class="delete-p-btn text-red-600 font-bold hover:underline" data-id="${p.id}">DELETE</button>`
          : `<span class="text-black/30">LOCKED</span>`;

        const growthColor = p.growth.startsWith("-") ? "text-red-600" : "text-green-600";

        tr.innerHTML = `
          <td class="py-3.5 pr-2 font-bold uppercase truncate max-w-[150px]">${p.name}</td>
          <td class="py-3.5 pr-2 uppercase text-black/60">${p.category}</td>
          <td class="py-3.5 pr-2 text-right">₹${p.price}</td>
          <td class="py-3.5 pr-2 text-right">${p.views || 0}</td>
          <td class="py-3.5 pr-2 text-right">${p.orders || 0}</td>
          <td class="py-3.5 pr-2 text-right font-bold ${growthColor}">${p.growth || "+0%"}</td>
          <td class="py-3.5 text-right font-bold">${actionHtml}</td>
        `;
        tableBody.appendChild(tr);
      });

      // Attach delete click listeners
      document.querySelectorAll(".delete-p-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-id");
          if (id) {
            let list = JSON.parse(localStorage.getItem("custom_products") || "[]");
            list = list.filter((item) => item.id !== id);
            localStorage.setItem("custom_products", JSON.stringify(list));
            renderAnalytics();
          }
        });
      });

    } catch (e) {
      console.error(e);
    }
  }

  checkSession();
</script>
